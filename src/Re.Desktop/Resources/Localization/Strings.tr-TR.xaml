    <sys:String x:Key="Settings.SessionTimeout">Oturum Zaman Aşımı (dakika)</sys:String>
    <sys:String x:Key="Settings.MinPasswordLength">Minimum Parola Uzunluğu</sys:String>
    <sys:String x:Key="Settings.AuditLogging">Denetim &amp; Loglama</sys:String>
