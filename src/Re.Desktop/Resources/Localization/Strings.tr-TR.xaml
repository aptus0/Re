    <sys:String x:Key="Settings.LogFailedLogins">Başarısız giriş denemelerini logla</sys:String>
    <sys:String x:Key="Settings.LockoutAfterAttempts">3 başarısız denemeden sonra hesabı geçici kilitle</sys:String>

    <!-- Barkod Ayarları -->
    <sys:String x:Key="Settings.BarcodeSetup">Barkod Yazıcı Yapılandırması</sys:String>
    <sys:String x:Key="Settings.PrinterName">Yazıcı Adı / Windows Kuyruğu</sys:String>
    <sys:String x:Key="Settings.PrinterLang">Yazıcı Dili (ZPL/TSPL/EPL)</sys:String>
    <sys:String x:Key="Settings.ResolutionDpi">Çözünürlük (DPI)</sys:String>

    <!-- Salesforce Entegrasyon Ayarları -->
    <sys:String x:Key="Salesforce.Title">Salesforce Çalışma Alanı</sys:String>
    <sys:String x:Key="Salesforce.Subtitle">Güvenli gömülü Lightning masaüstü çalışma alanı</sys:String>
    <sys:String x:Key="Salesforce.OAuthHeader">OAuth &amp; Connected App Yapılandırması</sys:String>
    <sys:String x:Key="Salesforce.AutoSyncHeader">ERP → Salesforce Otomatik Senkronizasyon</sys:String>
    <sys:String x:Key="Salesforce.SyncAccounts">Carileri Otomatik Senkronize Et</sys:String>
    <sys:String x:Key="Salesforce.SyncProducts">Ürün &amp; Fiyat Listelerini Senkronize Et</sys:String>
    <sys:String x:Key="Salesforce.SyncInvoices">Faturaları (Opportunity) Senkronize Et</sys:String>
    <sys:String x:Key="Salesforce.SyncNow">Tüm Verileri Şimdi Senkronize Et</sys:String>
</ResourceDictionary>
