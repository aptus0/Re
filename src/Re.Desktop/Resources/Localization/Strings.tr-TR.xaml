<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Diyaloglar -->
    <sys:String x:Key="Dialog.Information">Bilgi</sys:String>
    <sys:String x:Key="Dialog.Success">Başarılı</sys:String>
    <sys:String x:Key="Dialog.Warning">Uyarı</sys:String>
    <sys:String x:Key="Dialog.Error">Hata</sys:String>
    <sys:String x:Key="Dialog.Confirmation">Onay</sys:String>
    <sys:String x:Key="Dialog.OK">Tamam</sys:String>
    <sys:String x:Key="Dialog.Yes">Evet</sys:String>
    <sys:String x:Key="Dialog.No">Hayır</sys:String>

    <!-- Ayarlar Ana Başlıklar -->
    <sys:String x:Key="Settings.Title">Sistem Ayarları</sys:String>
    <sys:String x:Key="Settings.Subtitle">Firma, stok, finans, güvenlik, barkod ve Salesforce entegrasyon tercihlerini yönetin.</sys:String>
    <sys:String x:Key="Settings.NoChanges">Değişiklik yok</sys:String>
    <sys:String x:Key="Settings.SaveChanges">Değişiklikleri Kaydet</sys:String>
    <sys:String x:Key="Settings.ResetDefaults">Varsayılanlara Sıfırla</sys:String>
    <sys:String x:Key="Settings.LanguageApplied">Dil tercihi başarıyla uygulandı.</sys:String>

    <!-- Ayarlar Tab Başlıkları -->
    <sys:String x:Key="Settings.Tab.Company">Firma &amp; Şube</sys:String>
    <sys:String x:Key="Settings.Tab.Inventory">Stok &amp; Depo</sys:String>
    <sys:String x:Key="Settings.Tab.Documents">Evrak &amp; Finans</sys:String>
    <sys:String x:Key="Settings.Tab.Security">Güvenlik &amp; Log</sys:String>
    <sys:String x:Key="Settings.Tab.Barcode">Barkod &amp; Yazıcı</sys:String>
    <sys:String x:Key="Settings.Tab.System">Sistem &amp; Yedek</sys:String>
    <sys:String x:Key="Settings.Tab.Salesforce">Salesforce Entegrasyonu</sys:String>

    <!-- Firma Ayarları -->
    <sys:String x:Key="Settings.CompanyIdentity">Firma Kimlik Bilgileri</sys:String>
    <sys:String x:Key="Settings.CompanyName">Firma Unvanı (Legal Name)</sys:String>
    <sys:String x:Key="Settings.TaxNumber">Vergi Numarası / TCKN</sys:String>
    <sys:String x:Key="Settings.TaxOffice">Vergi Dairesi</sys:String>
    <sys:String x:Key="Settings.DefaultCurrency">Varsayılan Para Birimi</sys:String>
    <sys:String x:Key="Settings.LanguageRegion">Dil &amp; Bölge Ayarları</sys:String>
    <sys:String x:Key="Settings.Language">Arayüz Dili</sys:String>
    <sys:String x:Key="Settings.English">İngilizce (English - US)</sys:String>
    <sys:String x:Key="Settings.Turkish">Türkçe (Türkiye - TR)</sys:String>
    <sys:String x:Key="Settings.DateFormat">Tarih &amp; Saat Formatı</sys:String>
    <sys:String x:Key="Settings.BranchOps">Şube &amp; Operasyon Kuralları</sys:String>
    <sys:String x:Key="Settings.RequireBranch">İşlemlerde şube seçimini zorunlu kıl</sys:String>
    <sys:String x:Key="Settings.RestrictUserBranch">Kullanıcıları sadece yetkili oldukları şubelerle sınırla</sys:String>
    <sys:String x:Key="Settings.BranchDocSeries">Şube bazında ayrı evrak serisi takibi yap</sys:String>

    <!-- Stok Ayarları -->
    <sys:String x:Key="Settings.StockRules">Stok Ticari İş Kuralları</sys:String>
    <sys:String x:Key="Settings.AllowNegativeStock">Eksi stok seviyesine izin ver</sys:String>
