<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="Dialog.Information">Information</sys:String>
    <sys:String x:Key="Dialog.Success">Success</sys:String>
    <sys:String x:Key="Dialog.Warning">Warning</sys:String>
    <sys:String x:Key="Dialog.Error">Error</sys:String>
    <sys:String x:Key="Dialog.Confirmation">Confirmation</sys:String>
    <sys:String x:Key="Dialog.OK">OK</sys:String>
    <sys:String x:Key="Dialog.Yes">Yes</sys:String>
    <sys:String x:Key="Dialog.No">No</sys:String>

    <sys:String x:Key="Settings.Language">Interface Language</sys:String>
    <sys:String x:Key="Settings.English">English (United States)</sys:String>
    <sys:String x:Key="Settings.Turkish">Turkish (Türkiye)</sys:String>
    <sys:String x:Key="Settings.LanguageApplied">Language preference applied.</sys:String>

    <sys:String x:Key="Salesforce.Title">Salesforce Workspace</sys:String>
    <sys:String x:Key="Salesforce.Subtitle">Secure embedded Lightning desktop workspace</sys:String>
    <sys:String x:Key="Salesforce.Gemini">Gemini AI Studio</sys:String>
    <sys:String x:Key="Salesforce.Developer">Developer Studio</sys:String>
    <sys:String x:Key="Salesforce.NewProposal">New Proposal</sys:String>
    <sys:String x:Key="Salesforce.Refresh">Refresh</sys:String>
    <sys:String x:Key="Salesforce.ResetSession">Reset Session</sys:String>
    <sys:String x:Key="Salesforce.ConnectionReady">Salesforce Connection Ready</sys:String>
    <sys:String x:Key="Salesforce.ConnectionHelp">Sign in once to open your Lightning workspace. Your encrypted browser profile, cookies, and local cache remain available on this Windows account.</sys:String>
    <sys:String x:Key="Salesforce.Connect">Connect to Salesforce</sys:String>
    <sys:String x:Key="Salesforce.ResetPrompt">The saved Salesforce session and cookies will be cleared. Continue?</sys:String>
    <sys:String x:Key="Salesforce.SessionCleared">Salesforce session cleared.</sys:String>
    <sys:String x:Key="Salesforce.DesktopMode">Desktop mode</sys:String>
</ResourceDictionary>
