<UserControl x:Class="Re.Desktop.Views.StockMovements.StockMovementsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#EEF1F4">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#202328"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#98A5B4"/><Setter Property="Padding" Value="8,5"/><Setter Property="Height" Value="34"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#202328"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#98A5B4"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style x:Key="Metric" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#AEB8C4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><TextBlock Text="Stok Hareketleri" FontSize="24" FontWeight="SemiBold" Foreground="#202328"/><TextBlock Text="Denetlenebilir giriş, çıkış, transfer, sayım, üretim ve fire hareketleri" Foreground="#667085" FontSize="12"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="Yenile" Command="{Binding LoadCommand}" Padding="14,8" Margin="0,0,7,0" Background="White" Foreground="#202328" BorderBrush="#98A5B4"/>
    <Button Content="Excel'e Aktar" Command="{Binding ExportCommand}" Padding="14,8" Background="#202328" Foreground="White" BorderThickness="0"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#AEB8C4" BorderThickness="1" Padding="12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="145"/><ColumnDefinition Width="10"/><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/><ColumnDefinition Width="6"/><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition Width="86"/><ColumnDefinition Width="6"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ürün kodu, adı, barkod veya belge türü"/>
    <ComboBox Grid.Column="2" ItemsSource="{Binding Directions}" SelectedItem="{Binding SelectedDirection}"/>
    <ComboBox Grid.Column="4" ItemsSource="{Binding Source={x:Static local:StockMovementsViewModel.MovementTypes}}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMovementType}" xmlns:local="clr-namespace:Re.Desktop.ViewModels.StockMovements"/>
    <DatePicker Grid.Column="6" SelectedDate="{Binding StartDate}" Height="34" VerticalContentAlignment="Center"/>
    <DatePicker Grid.Column="8" SelectedDate="{Binding EndDate}" Height="34" VerticalContentAlignment="Center"/>
    <Button Grid.Column="10" Content="Uygula" Command="{Binding LoadCommand}" Background="#B5121B" Foreground="White" BorderThickness="0"/>
    <Button Grid.Column="12" Content="Temizle" Command="{Binding ClearCommand}" Background="White" Foreground="#202328" BorderBrush="#98A5B4"/>
   </Grid>
  </Border>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Metric}"><StackPanel><TextBlock Text="BUGÜNKÜ GİRİŞ" FontSize="10" Foreground="#667085"/><TextBlock Text="{Binding TodayInbound, StringFormat='{}{0:N2}'}" FontSize="19" FontWeight="Bold" Foreground="#166534"/><TextBlock Text="{Binding TodayMovementCount, StringFormat='Bugün {0} hareket'}" FontSize="10" Foreground="#667085"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Metric}"><StackPanel><TextBlock Text="BUGÜNKÜ ÇIKIŞ" FontSize="10" Foreground="#667085"/><TextBlock Text="{Binding TodayOutbound, StringFormat='{}{0:N2}'}" FontSize="19" FontWeight="Bold" Foreground="#B5121B"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Metric}"><StackPanel><TextBlock Text="DÖNEM GİRİŞİ" FontSize="10" Foreground="#667085"/><TextBlock Text="{Binding PeriodInbound, StringFormat='{}{0:N2}'}" FontSize="19" FontWeight="Bold"/></StackPanel></Border>
   <Border Grid.Column="3" Style="{StaticResource Metric}"><StackPanel><TextBlock Text="DÖNEM ÇIKIŞI" FontSize="10" Foreground="#667085"/><TextBlock Text="{Binding PeriodOutbound, StringFormat='{}{0:N2}'}" FontSize="19" FontWeight="Bold"/></StackPanel></Border>
   <Border Grid.Column="4" Style="{StaticResource Metric}" Margin="0"><StackPanel><TextBlock Text="NET DEĞİŞİM" FontSize="10" Foreground="#667085"/><TextBlock Text="{Binding PeriodNet, StringFormat='{}{0:N2}'}" FontSize="19" FontWeight="Bold" Foreground="#B5121B"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="6" Background="White" BorderBrush="#8996A5" BorderThickness="1">
   <Grid>
    <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0" RowHeight="38" AlternatingRowBackground="#F3F5F7" GridLinesVisibility="All" HorizontalGridLinesBrush="#D1D5DB" VerticalGridLinesBrush="#D1D5DB" SelectionUnit="FullRow">
     <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202328"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,9"/><Setter Property="BorderBrush" Value="#59616C"/><Setter Property="BorderThickness" Value="0,0,1,0"/></Style></DataGrid.ColumnHeaderStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Tarih / Saat" Binding="{Binding MovementDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="126"/>
      <DataGridTextColumn Header="Hareket Türü" Binding="{Binding MovementTypeName}" Width="135"/>
      <DataGridTextColumn Header="Yön" Binding="{Binding Direction}" Width="62"/>
      <DataGridTextColumn Header="Ürün Kodu" Binding="{Binding ProductCode}" Width="105"/>
      <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="*"/>
      <DataGridTextColumn Header="Barkod" Binding="{Binding Barcode}" Width="120"/>
      <DataGridTextColumn Header="Varyant" Binding="{Binding VariantCode}" Width="90"/>
      <DataGridTextColumn Header="Depo" Binding="{Binding WarehouseName}" Width="120"/>
      <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, StringFormat='N4'}" Width="82"/>
      <DataGridTextColumn Header="Birim Maliyet" Binding="{Binding UnitCost, StringFormat='N2'}" Width="92"/>
      <DataGridTextColumn Header="Tutar" Binding="{Binding TotalCost, StringFormat='N2'}" Width="92"/>
      <DataGridTextColumn Header="Bakiye" Binding="{Binding StockAfterMovement, StringFormat='N4'}" Width="82"/>
      <DataGridTextColumn Header="Belge" Binding="{Binding ReferenceDocumentType}" Width="105"/>
      <DataGridTextColumn Header="Kullanıcı" Binding="{Binding UserName}" Width="95"/>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Visibility="{Binding HasNoData, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="STOK HAREKETİ YOK" FontWeight="Bold" Foreground="#4B5563" HorizontalAlignment="Center"/><TextBlock Text="Seçilen tarih ve filtrelere uygun gerçek hareket kaydı bulunamadı." Foreground="#6B7280" Margin="0,5,0,0"/></StackPanel>
    <Border Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Background="#CCFFFFFF"><TextBlock Text="Stok hareketleri yükleniyor..." Foreground="#B5121B" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Grid>
  </Border>
  <Border Grid.Row="7" Background="#E5E7EB" BorderBrush="#AEB8C4" BorderThickness="1,0,1,1" Padding="10,6"><Grid><TextBlock Text="{Binding TotalCount, StringFormat='Toplam {0} gerçek hareket kaydı'}" Foreground="#374151" FontSize="11"/><TextBlock Text="Kayıtlar fiziksel olarak silinmez • Düzeltmeler ters hareket ile yapılır" HorizontalAlignment="Right" Foreground="#B5121B" FontSize="11" FontWeight="SemiBold"/></Grid></Border>
 </Grid>
</UserControl>
