<UserControl x:Class="Re.Desktop.Views.StockMovements.StockMovementsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Re.Desktop.ViewModels.StockMovements"
             Background="#F8FAFC">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#54698D"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="#F4F6F9"/>
            <Setter Property="BorderBrush" Value="#D8DDE6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0070D2"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                    <Setter Property="BorderBrush" Value="#D8DDE6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Bar -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/> <!-- Filter Bar -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>    <!-- Data Section -->
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Inventory &amp; Warehouses" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Real-time warehouse balances, auditable movements, and stock traceability." Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ New Operation" Command="{Binding NewOperationCommand}" Background="#0070D2" Foreground="White" BorderThickness="0" Padding="16,8" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="Refresh" Command="{Binding LoadCommand}" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"/>
                <Button Content="Export CSV" Command="{Binding ExportCommand}" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="2" Columns="6" Rows="1">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TODAY RECEIPTS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TodayInbound, StringFormat='{}{0:N2}'}" Foreground="#10B981" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding TodayMovementCount, StringFormat='{}{0} movements'}" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TODAY ISSUES" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TodayOutbound, StringFormat='{}{0:N2}'}" Foreground="#EF4444" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="PERIOD NET" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PeriodNet, StringFormat='{}{0:N2}'}" Foreground="#0070D2" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="INVENTORY VALUE" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalInventoryValue, StringFormat='₺{0:N2}'}" Foreground="#059669" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="STOCK ALERTS" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CriticalBalanceCount}" Foreground="#D97706" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="Low or out of stock" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="WAREHOUSES" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TrackedWarehouseCount}" Foreground="#0F172A" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="With active stock" Foreground="#94A3B8" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter Bar -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search product name, code or document"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Directions}" SelectedItem="{Binding SelectedDirection}"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding Source={x:Static local:StockMovementsViewModel.MovementTypes}}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedMovementType}"/>
                <ComboBox Grid.Column="6" ItemsSource="{Binding WarehouseFilters}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWarehouse}"/>
                <DatePicker Grid.Column="8" SelectedDate="{Binding StartDate}" Height="34"/>
                <DatePicker Grid.Column="10" SelectedDate="{Binding EndDate}" Height="34"/>
                
                <StackPanel Grid.Column="12" Orientation="Horizontal">
                    <Button Content="Apply" Command="{Binding LoadCommand}" Background="#0070D2" Foreground="White" BorderThickness="0" Padding="14,0" Height="34" FontWeight="Bold" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="Reset" Command="{Binding ClearCommand}" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,0" Height="34" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid Tabs -->
        <Border Grid.Row="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <TabControl Background="White" BorderThickness="0">
                
                <!-- Tab 1: Movements Ledger -->
                <TabItem Header="📋 Movement Ledger">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="38" HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date / Time" Binding="{Binding MovementDate, StringFormat='dd.MM.yyyy HH:mm'}" Width="125"/>
                                <DataGridTextColumn Header="Operation" Binding="{Binding MovementTypeName}" Width="145"/>
                                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="85"/>
                                <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="110"/>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Variant" Binding="{Binding VariantCode}" Width="90"/>
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="125"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Balance" Binding="{Binding StockAfterMovement, StringFormat=N3}" Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat=N2}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Lot No" Binding="{Binding LotNumber}" Width="90"/>
                                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="105"/>
                                <DataGridTextColumn Header="Document" Binding="{Binding ReferenceDocumentType}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <StackPanel Visibility="{Binding HasNoData, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No inventory movements found" FontSize="16" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                            <TextBlock Text="Change the filters or post a new inventory operation." Foreground="#94A3B8" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                            <Grid>
                                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} movement records'}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Immutable Audit Ledger • Corrections create new movements" HorizontalAlignment="Right" Foreground="#059669" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Tab 2: Warehouse Balances -->
                <TabItem Header="🏢 Warehouse Balances">
                    <DataGrid ItemsSource="{Binding WarehouseBalances}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="38" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="120"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="135"/>
                            <DataGridTextColumn Header="Warehouse Code" Binding="{Binding WarehouseCode}" Width="125"/>
                            <DataGridTextColumn Header="Warehouse Name" Binding="{Binding WarehouseName}" Width="160"/>
                            <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand, StringFormat=N3}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Minimum Stock" Binding="{Binding MinStockLevel, StringFormat=N3}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Stock Value" Binding="{Binding StockValue, StringFormat='C2'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="7" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" Height="8" Foreground="#0070D2"/>
                <TextBlock Text="Loading inventory data..." Foreground="#475569" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
