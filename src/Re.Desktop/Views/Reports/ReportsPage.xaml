<UserControl x:Class="Re.Desktop.Views.Reports.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Report Center" Style="{StaticResource CorporatePageTitle}"/><TextBlock Text="Review inventory, sales, account, and finance performance in one place" Foreground="#666" FontSize="12"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Rapor Zamanla" Style="{StaticResource CorporateButton}" Margin="0,0,7,0"/>
                <Button Content="New Custom Report" Style="{StaticResource CorporatePrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#B8B8B8" BorderThickness="1" Padding="8">
                <TextBox Text="Search report name or description..." Foreground="#555" Background="White" BorderThickness="0"/>
            </Border>
            <ComboBox Grid.Column="2" SelectedIndex="0" Background="White" Foreground="#0F172A"><ComboBoxItem Content="All Modules"/><ComboBoxItem Content="Inventory"/><ComboBoxItem Content="Sales"/><ComboBoxItem Content="Accounts"/><ComboBoxItem Content="Finance"/></ComboBox>
            <DatePicker Grid.Column="4" Background="White" Foreground="#0F172A"/>
            <DatePicker Grid.Column="6" Background="White" Foreground="#0F172A"/>
            <Button Grid.Column="8" Content="Uygula" Style="{StaticResource CorporateButton}"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CorporateSurface}">
                <StackPanel>
                    <TextBlock Text="Rapor Categoryleri" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Button Content="Favori Reports              6" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Inventory &amp; Warehouse                14" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Sales and Profitability            12" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Accounts &amp; Risk                 10" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Finance and Cash Flow         8" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Tax and Accounting             7" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left"/>
                    <Border Background="#FDECEC" BorderBrush="#E4B1B1" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="Scheduled Reports" FontWeight="SemiBold" Foreground="#014486"/><TextBlock Text="3 reports are sent automatically." FontSize="10" Foreground="#666" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource CorporateSurface}" Margin="0,0,6,0"><StackPanel><TextBlock Text="MONTHLY SALES" FontSize="10" Foreground="#666"/><TextBlock Text="1.842.650 ₺" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="%12,4 increase" FontSize="10" Foreground="#555"/></StackPanel></Border>
                    <Border Style="{StaticResource CorporateSurface}" Margin="0,0,6,0"><StackPanel><TextBlock Text="GROSS PROFIT" FontSize="10" Foreground="#666"/><TextBlock Text="428.210 ₺" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="%23,2 margin" FontSize="10" Foreground="#555"/></StackPanel></Border>
                    <Border Style="{StaticResource CorporateSurface}" Margin="0,0,6,0"><StackPanel><TextBlock Text="TERM RECEIVABLES" FontSize="10" Foreground="#666"/><TextBlock Text="724.800 ₺" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="86 open documents" FontSize="10" Foreground="#555"/></StackPanel></Border>
                    <Border Style="{StaticResource CorporateSurface}"><StackPanel><TextBlock Text="CRITICAL RISK" FontSize="10" Foreground="#666"/><TextBlock Text="18 Accounts" FontSize="19" FontWeight="Bold" Foreground="#0176D3" Margin="0,5,0,0"/><TextBlock Text="Review required" FontSize="10" Foreground="#014486"/></StackPanel></Border>
                </UniformGrid>
                <Border Grid.Row="2" Style="{StaticResource CorporateSurface}" Padding="0">
                    <DataGrid Style="{StaticResource CorporateDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Report Name" Width="*"/>
                            <DataGridTextColumn Header="Category" Width="145"/>
                            <DataGridTextColumn Header="Last Run" Width="130"/>
                            <DataGridTextColumn Header="Readylayan" Width="120"/>
                            <DataGridTextColumn Header="Format" Width="90"/>
                            <DataGridTextColumn Header="Status" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
