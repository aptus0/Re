<UserControl x:Class="Re.Desktop.Views.Reports.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Rapor Merkezi" Style="{StaticResource CorporatePageTitle}"/><TextBlock Text="Stok, satış, cari ve finans performansını tek merkezden inceleyin" Foreground="#666" FontSize="12"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Rapor Zamanla" Style="{StaticResource CorporateButton}" Margin="0,0,7,0"/>
                <Button Content="Yeni Özel Rapor" Style="{StaticResource CorporatePrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#B8B8B8" BorderThickness="1" Padding="8">
                <TextBox Text="Rapor adı veya açıklama ara..." Foreground="#555" Background="White" BorderThickness="0"/>
            </Border>
            <ComboBox Grid.Column="2" SelectedIndex="0" Background="White" Foreground="#202124"><ComboBoxItem Content="Tüm Modüller"/><ComboBoxItem Content="Stok"/><ComboBoxItem Content="Satış"/><ComboBoxItem Content="Cari"/><ComboBoxItem Content="Finans"/></ComboBox>
            <DatePicker Grid.Column="4" Background="White" Foreground="#202124"/>
            <DatePicker Grid.Column="6" Background="White" Foreground="#202124"/>
            <Button Grid.Column="8" Content="Uygula" Style="{StaticResource CorporateButton}"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CorporateSurface}">
                <StackPanel>
                    <TextBlock Text="Rapor Kategorileri" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Button Content="Favori Raporlar              6" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Stok ve Depo                14" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Satış ve Kârlılık            12" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Cari ve Risk                 10" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Finans ve Nakit Akışı         8" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                    <Button Content="Vergi ve Muhasebe             7" Style="{StaticResource CorporateButton}" HorizontalContentAlignment="Left"/>
                    <Border Background="#FDECEC" BorderBrush="#E4B1B1" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                        <StackPanel><TextBlock Text="Zamanlanmış Raporlar" FontWeight="SemiBold" Foreground="#8E1717"/><TextBlock Text="3 rapor otomatik gönderiliyor." FontSize="10" Foreground="#666" Margin="0,3,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource CorporateSurface}" Margin="0,0,6,0"><StackPanel><TextBlock Text="AYLIK SATIŞ" FontSize="10" Foreground="#666"/><TextBlock Text="1.842.650 ₺" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="%12,4 artış" FontSize="10" Foreground="#555"/></StackPanel></Border>
                    <Border Style="{StaticResource CorporateSurface}" Margin="0,0,6,0"><StackPanel><TextBlock Text="BRÜT KÂR" FontSize="10" Foreground="#666"/><TextBlock Text="428.210 ₺" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="%23,2 marj" FontSize="10" Foreground="#555"/></StackPanel></Border>
                    <Border Style="{StaticResource CorporateSurface}" Margin="0,0,6,0"><StackPanel><TextBlock Text="VADELİ ALACAK" FontSize="10" Foreground="#666"/><TextBlock Text="724.800 ₺" FontSize="19" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="86 açık belge" FontSize="10" Foreground="#555"/></StackPanel></Border>
                    <Border Style="{StaticResource CorporateSurface}"><StackPanel><TextBlock Text="KRİTİK RİSK" FontSize="10" Foreground="#666"/><TextBlock Text="18 Cari" FontSize="19" FontWeight="Bold" Foreground="#C62828" Margin="0,5,0,0"/><TextBlock Text="İnceleme gerekli" FontSize="10" Foreground="#8E1717"/></StackPanel></Border>
                </UniformGrid>
                <Border Grid.Row="2" Style="{StaticResource CorporateSurface}" Padding="0">
                    <DataGrid Style="{StaticResource CorporateDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rapor Adı" Width="*"/>
                            <DataGridTextColumn Header="Kategori" Width="145"/>
                            <DataGridTextColumn Header="Son Çalıştırma" Width="130"/>
                            <DataGridTextColumn Header="Hazırlayan" Width="120"/>
                            <DataGridTextColumn Header="Format" Width="90"/>
                            <DataGridTextColumn Header="Durum" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
