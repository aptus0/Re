<Window x:Class="Re.Desktop.Views.Products.ProductVariantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ürün Varyantları" Width="900" Height="540" WindowStartupLocation="CenterOwner" Background="#F4F5F7">
 <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#202328" Padding="18"><StackPanel><TextBlock Text="ÜRÜN VARYANT MERKEZİ" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding ProductName}" Foreground="#CCD0D5"/></StackPanel></Border>
  <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <DataGrid ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34">
    <DataGrid.Columns><DataGridTextColumn Header="KOD" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="RENK" Binding="{Binding Color}" Width="*"/><DataGridTextColumn Header="BEDEN" Binding="{Binding Size}" Width="80"/><DataGridTextColumn Header="FİYAT" Binding="{Binding SalePrice, StringFormat=N2}" Width="100"/><DataGridCheckBoxColumn Header="AKTİF" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns>
   </DataGrid>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" Padding="16"><StackPanel>
    <TextBlock Text="Varyant Kartı" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="Varyant kodu *"/><TextBox Text="{Binding Code}" Margin="0,3,0,8"/><TextBlock Text="Renk"/><TextBox Text="{Binding Color}" Margin="0,3,0,8"/><TextBlock Text="Beden"/><TextBox Text="{Binding Size}" Margin="0,3,0,8"/><TextBlock Text="Özellik 1"/><TextBox Text="{Binding Attribute1}" Margin="0,3,0,8"/><TextBlock Text="Özellik 2"/><TextBox Text="{Binding Attribute2}" Margin="0,3,0,8"/><TextBlock Text="Satış fiyatı"/><TextBox Text="{Binding SalePrice}" Margin="0,3,0,14"/>
    <StackPanel Orientation="Horizontal"><Button Content="Yeni" Command="{Binding NewVariantCommand}" Padding="12,7"/><Button Content="Kaydet" Command="{Binding SaveCommand}" Background="#B5121B" Foreground="White" BorderThickness="0" Padding="12,7" Margin="6,0"/><Button Content="Pasife Al" Command="{Binding DeleteCommand}" Background="#202328" Foreground="White" BorderThickness="0" Padding="12,7"/></StackPanel>
   </StackPanel></Border>
  </Grid>
 </Grid>
</Window>
