<Window x:Class="Re.Desktop.Views.Products.ProductVariantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Product Variants" Width="1040" Height="620" WindowStartupLocation="CenterOwner" Background="#F4F5F7">
 <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#0F172A" Padding="18"><StackPanel><TextBlock Text="PRODUCT VARIANT CENTER" Foreground="White" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding ProductName}" Foreground="#CCD0D5"/></StackPanel></Border>
  <Grid Grid.Row="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
   <DataGrid ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34">
    <DataGrid.Columns><DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="130"/><DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="*"/><DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="80"/><DataGridTextColumn Header="ATTRIBUTE 1" Binding="{Binding Attribute1}" Width="*"/><DataGridTextColumn Header="ATTRIBUTE 2" Binding="{Binding Attribute2}" Width="*"/><DataGridTextColumn Header="PRICE" Binding="{Binding SalePrice, StringFormat=N2}" Width="100"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="65"/></DataGrid.Columns>
   </DataGrid>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" Padding="16"><StackPanel>
    <TextBlock Text="Variant Card" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="Variant code *"/><TextBox Text="{Binding Code}" Margin="0,3,0,8"/><TextBlock Text="Color"/><TextBox Text="{Binding Color}" Margin="0,3,0,8"/><TextBlock Text="Size"/><TextBox Text="{Binding Size}" Margin="0,3,0,8"/><TextBlock Text="Attribute 1"/><TextBox Text="{Binding Attribute1}" Margin="0,3,0,8"/><TextBlock Text="Attribute 2"/><TextBox Text="{Binding Attribute2}" Margin="0,3,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sales price"/><TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Difference from base"/><TextBlock Text="{Binding PriceDifference, StringFormat='₺{0:N2}'}" FontSize="16" FontWeight="Bold" Margin="0,8"/></StackPanel></Grid>
    <CheckBox Content="Variant is active and available for transactions" IsChecked="{Binding IsActive}" Margin="0,2,0,14"/>
    <StackPanel Orientation="Horizontal"><Button Content="New" Command="{Binding NewVariantCommand}" Padding="12,7"/><Button Content="Save" Command="{Binding SaveCommand}" Background="#0176D3" Foreground="White" BorderThickness="0" Padding="12,7" Margin="6,0"/><Button Content="Deactivate" Command="{Binding DeleteCommand}" Background="#0F172A" Foreground="White" BorderThickness="0" Padding="12,7"/></StackPanel>
   </StackPanel></Border>
  </Grid>
 </Grid>
</Window>
