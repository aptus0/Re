<Window x:Class="Re.Desktop.Views.Products.CatalogItemQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Add Catalog Item" Width="400" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" UseLayoutRounding="True">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Inputs -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#032D60" Padding="16,12">
            <TextBlock x:Name="TitleLabel" Text="ADD NEW ITEM" Foreground="White" FontSize="14" FontWeight="Bold"/>
        </Border>

        <!-- Inputs -->
        <StackPanel Grid.Row="1" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Code (Short identifier) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ItemCode" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,12"/>
            
            <TextBlock Text="Name *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ItemName" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" BorderThickness="1"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Width="80" Height="32" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="Save" Click="Save_Click" Width="100" Height="32" Background="#0070D2" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
