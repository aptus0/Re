<Window x:Class="Re.Desktop.Views.Products.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding FormTitle}" Width="960" Height="680" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- Custom Title Bar -->
            <RowDefinition Height="*"/>    <!-- Content Area -->
            <RowDefinition Height="54"/>   <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Custom Drag Title Bar -->
        <Border Grid.Row="0" Background="#032D60" MouseDown="TitleBar_MouseDown" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FormTitle}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PRODUCT CARD • RE ERP" Foreground="#9ED7FF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="×" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Padding="0" Width="30" Height="30" Cursor="Hand" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form Grid -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Product Image Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <Border Height="200" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="No Image Selected" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding FormModel.ImagePath}" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <Button Content="Select Image" Click="SelectImage_Click" Margin="0,16,0,6" Background="#0070D2" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Remove Image" Click="RemoveImage_Click" Background="White" Foreground="#BA0517" BorderBrush="#BA0517" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock Text="PNG or JPEG • Max 5 MB" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right: Tab Control for Product Settings -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                <TabControl BorderThickness="0" Background="White">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#54698D"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="Background" Value="#F4F6F9"/>
                            <Setter Property="BorderBrush" Value="#D8DDE6"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#0070D2"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                    <Setter Property="BorderBrush" Value="#D8DDE6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>
                    
                    <TabItem Header="Product Card">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Basic Details" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Product Code *" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding FormModel.Code, UpdateSourceTrigger=PropertyChanged}"/>
                                        
                                        <TextBlock Text="Category *" FontWeight="SemiBold"/>
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding CatalogCategories}" DisplayMemberPath="Name" SelectedItem="{Binding FormModel.SelectedCategory}" Height="32" Margin="0"/>
                                            <Button Grid.Column="2" Content="+" Command="{Binding AddCategoryDirectCommand}" Background="#0070D2" Foreground="White" BorderThickness="0" Height="32" Padding="0" FontWeight="Bold" FontSize="16" Cursor="Hand"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Barcode (EAN-13 auto-generated if empty)"/>
                                        <TextBox Text="{Binding FormModel.Barcode1}"/>
                                        
                                        <TextBlock Text="Purchase Price (TL)"/>
                                        <TextBox Text="{Binding FormModel.PurchasePrice, UpdateSourceTrigger=PropertyChanged}"/>
                                        
                                        <TextBlock Text="Minimum Stock Limit"/>
                                        <TextBox Text="{Binding FormModel.MinStockLevel}"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Product Name *" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding FormModel.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        
                                        <TextBlock Text="Brand *" FontWeight="SemiBold"/>
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding CatalogBrands}" DisplayMemberPath="Name" SelectedItem="{Binding FormModel.SelectedBrand}" Height="32" Margin="0"/>
                                            <Button Grid.Column="2" Content="+" Command="{Binding AddBrandDirectCommand}" Background="#0070D2" Foreground="White" BorderThickness="0" Height="32" Padding="0" FontWeight="Bold" FontSize="16" Cursor="Hand"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Collection / Season"/>
                                        <TextBox Text="{Binding FormModel.Season}"/>
                                        
                                        <TextBlock Text="Sales Price (TL, VAT included)"/>
                                        <TextBox Text="{Binding FormModel.SalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                                        
                                        <TextBlock Text="Maximum Stock Limit"/>
                                        <TextBox Text="{Binding FormModel.MaxStockLevel}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Border Background="#F0F9FF" BorderBrush="#B9E6FE" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="VAT Rate" FontWeight="SemiBold"/>
                                            <ComboBox ItemsSource="{Binding TaxRates}" DisplayMemberPath="Display" SelectedValuePath="Rate" SelectedValue="{Binding FormModel.VatRate}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Net Sales Price" Foreground="#475569" FontSize="11"/>
                                            <TextBlock Text="{Binding FormModel.NetSalePrice, StringFormat='₺{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="VAT / Gross Margin" Foreground="#475569" FontSize="11"/>
                                            <TextBlock FontSize="15" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0">
                                                <Run Text="{Binding FormModel.VatAmount, StringFormat='₺{0:N2}'}"/>
                                                <Run Text="{Binding FormModel.GrossMargin, StringFormat='  /  %{0:N1}'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <Separator Background="#E2E8F0" Margin="0,8"/>
                                <TextBlock Text="Warehouse &amp; Supplier" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Default Warehouse"/>
                                        <TextBox Text="{Binding FormModel.Warehouse}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Primary Supplier"/>
                                        <TextBox Text="{Binding FormModel.SupplierName}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <TabItem Header="Product Variants">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,12">
                                <Button Content="+ Add Variant" Command="{Binding AddVariantCommand}" Background="#032D60" Foreground="White" BorderThickness="0" Padding="12,6">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                </Button>
                                <TextBlock Text="Link sizes, colors, and stock attributes to the master product." Margin="12,5,0,0" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding FormModel.Variants}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                      GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="36">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#0F172A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Variant Code *" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="*"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                                    <DataGridTextColumn Header="Attr 1" Binding="{Binding Attribute1}" Width="*"/>
                                    <DataGridTextColumn Header="Sales Price" Binding="{Binding SalePrice}" Width="*"/>
                                    <DataGridTemplateColumn Header="" Width="65">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Foreground="#BA0517" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer Actions Bar -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Discard" Click="Cancel_Click" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0" Width="90">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
                <Button Content="Save Product" Command="{Binding SaveProductCommand}" Background="#0070D2" Foreground="White" BorderThickness="0" Width="130">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
