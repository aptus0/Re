<Window x:Class="Re.Desktop.Views.Products.ProductEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding FormTitle}" Width="960" Height="680" MinWidth="820" MinHeight="580"
 WindowStartupLocation="CenterOwner" Background="#F4F5F7">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17191C"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="8,4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
  <Border Background="#202328" Padding="18,0"><Grid><TextBlock Text="{Binding FormTitle}" Foreground="White" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="ÜRÜN KARTI • RE ERP" Foreground="#D7D9DD" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Border>
  <Grid Grid.Row="1" Margin="18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#D9DDE3" BorderThickness="1" CornerRadius="4" Padding="14">
    <StackPanel>
     <Border Height="210" Background="#F2F3F5" BorderBrush="#D9DDE3" BorderThickness="1"><Grid><TextBlock Text="Ürün görseli" Foreground="#8A9099" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding FormModel.ImagePath}" Stretch="Uniform"/></Grid></Border>
     <Button Content="Görsel Seç" Click="SelectImage_Click" Margin="0,12,0,6" Background="#202328" Foreground="White" BorderThickness="0"/>
     <Button Content="Görseli Kaldır" Click="RemoveImage_Click" Background="White" Foreground="#B5121B" BorderBrush="#B5121B"/>
     <TextBlock Text="PNG veya JPEG • En fazla 5 MB" FontSize="10" Foreground="#737982" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" CornerRadius="4" Padding="12">
    <TabControl>
     <TabItem Header="Ürün Kartı">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="12">
        <TextBlock Text="Temel Bilgiler" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Ürün kodu *"/><TextBox Text="{Binding FormModel.Code, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Kategori *"/><ComboBox ItemsSource="{Binding CatalogCategories}" DisplayMemberPath="Name" SelectedItem="{Binding FormModel.SelectedCategory}"/><TextBlock Text="Barkod (boşsa otomatik EAN-13)"/><TextBox Text="{Binding FormModel.Barcode1}"/><TextBlock Text="Alış fiyatı"/><TextBox Text="{Binding FormModel.PurchasePrice}"/><TextBlock Text="Minimum stok"/><TextBox Text="{Binding FormModel.MinStockLevel}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Ürün adı *"/><TextBox Text="{Binding FormModel.Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Marka *"/><ComboBox ItemsSource="{Binding CatalogBrands}" DisplayMemberPath="Name" SelectedItem="{Binding FormModel.SelectedBrand}"/><TextBlock Text="Koleksiyon / sezon"/><TextBox Text="{Binding FormModel.Season}"/><TextBlock Text="Satış fiyatı"/><TextBox Text="{Binding FormModel.SalePrice}"/><TextBlock Text="Maksimum stok"/><TextBox Text="{Binding FormModel.MaxStockLevel}"/></StackPanel>
        </Grid>
        <Separator Margin="0,8"/><TextBlock Text="Depo ve Tedarik" FontSize="16" FontWeight="SemiBold" Margin="0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Depo"/><TextBox Text="{Binding FormModel.Warehouse}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Tedarikçi"/><TextBox Text="{Binding FormModel.SupplierName}"/></StackPanel></Grid>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="Varyantlar">
      <Grid Margin="12">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,10"><Button Content="+ Varyant Ekle" Command="{Binding AddVariantCommand}" Background="#202328" Foreground="White" BorderThickness="0"/><TextBlock Text="Renk, beden ve fiyat kombinasyonlarını ürünle birlikte kaydedin." Margin="12,7,0,0" Foreground="#60656D"/></DockPanel>
       <DataGrid Grid.Row="1" ItemsSource="{Binding FormModel.Variants}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Varyant Kodu *" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
         <DataGridTextColumn Header="Renk" Binding="{Binding Color}" Width="*"/><DataGridTextColumn Header="Beden" Binding="{Binding Size}" Width="*"/>
         <DataGridTextColumn Header="Özellik 1" Binding="{Binding Attribute1}" Width="*"/><DataGridTextColumn Header="Özellik 2" Binding="{Binding Attribute2}" Width="*"/>
         <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding SalePrice}" Width="*"/>
         <DataGridTemplateColumn Header="" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Sil" Foreground="#B5121B" Background="Transparent" BorderThickness="0" Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="0,1,0,0" Padding="18,9"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Vazgeç" Click="Cancel_Click" Background="White" Foreground="#202328" BorderBrush="#AEB3BA" Margin="0,0,8,0"/><Button Content="Ürünü Kaydet" Command="{Binding SaveProductCommand}" Background="#B5121B" Foreground="White" BorderThickness="0"/></StackPanel></Border>
 </Grid>
</Window>
