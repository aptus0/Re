<Window x:Class="Re.Desktop.Views.Products.ProductCatalogWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Catalog Management" Width="980" Height="650" MinWidth="820" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="#F4F5F7">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17191C"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="31"/><Setter Property="Margin" Value="0,4,0,10"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="34"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Background="#0F172A" Padding="18"><StackPanel><TextBlock Text="CATALOG MANAGEMENT CENTER" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Manage categories, brands, and seasonal collections centrally" Foreground="#C9CDD2" FontSize="11"/></StackPanel></Border>
  <TabControl Grid.Row="1" Margin="14">
   <TabItem Header="Categoryler"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"><DataGrid.Columns><DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="CATEGORY" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="Category Card" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Code *"/><TextBox Text="{Binding CategoryCode}"/><TextBlock Text="Category name *"/><TextBox Text="{Binding CategoryName}"/><TextBlock Text="Description"/><TextBox Text="{Binding CategoryDescription}" Height="70" AcceptsReturn="True"/><StackPanel Orientation="Horizontal"><Button Content="New" Command="{Binding NewCategoryCommand}" Background="White"/><Button Content="Save" Command="{Binding SaveCategoryCommand}" Background="#0176D3" Foreground="White" BorderThickness="0"/><Button Content="Deactivate" Command="{Binding DeleteCategoryCommand}" Background="#0F172A" Foreground="White" BorderThickness="0"/></StackPanel></StackPanel></Border>
   </Grid></TabItem>
   <TabItem Header="Brandlar"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}"><DataGrid.Columns><DataGridTextColumn Header="BRAND" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="LOGO" Binding="{Binding Detail}" Width="220"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="Brand Card" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Brand code *"/><TextBox Text="{Binding BrandCode}"/><TextBlock Text="Brand name *"/><TextBox Text="{Binding BrandName}"/><TextBlock Text="Logo file path"/><TextBox Text="{Binding BrandLogoPath}"/><StackPanel Orientation="Horizontal"><Button Content="New" Command="{Binding NewBrandCommand}"/><Button Content="Save" Command="{Binding SaveBrandCommand}" Background="#0176D3" Foreground="White" BorderThickness="0"/><Button Content="Deactivate" Command="{Binding DeleteBrandCommand}" Background="#0F172A" Foreground="White" BorderThickness="0"/></StackPanel></StackPanel></Border>
   </Grid></TabItem>
   <TabItem Header="Koleksiyonlar"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DataGrid ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection}"><DataGrid.Columns><DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="COLLECTION" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="SEASON" Binding="{Binding Detail}" Width="130"/><DataGridCheckBoxColumn Header="ACTIVE" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid>
    <Border Grid.Column="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="1" Padding="16"><StackPanel><TextBlock Text="Collection Card" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Code *"/><TextBox Text="{Binding CollectionCode}"/><TextBlock Text="Collection name *"/><TextBox Text="{Binding CollectionName}"/><TextBlock Text="Season"/><TextBox Text="{Binding CollectionSeason}"/><TextBlock Text="Start"/><DatePicker SelectedDate="{Binding CollectionStartDate}" Margin="0,4,0,10"/><TextBlock Text="End"/><DatePicker SelectedDate="{Binding CollectionEndDate}" Margin="0,4,0,14"/><StackPanel Orientation="Horizontal"><Button Content="New" Command="{Binding NewCollectionCommand}"/><Button Content="Save" Command="{Binding SaveCollectionCommand}" Background="#0176D3" Foreground="White" BorderThickness="0"/><Button Content="Deactivate" Command="{Binding DeleteCollectionCommand}" Background="#0F172A" Foreground="White" BorderThickness="0"/></StackPanel></StackPanel></Border>
   </Grid></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#D9DDE3" BorderThickness="0,1,0,0" Padding="14,8"><TextBlock Text="{Binding StatusText}" Foreground="#626871" FontSize="11"/></Border>
 </Grid>
</Window>
