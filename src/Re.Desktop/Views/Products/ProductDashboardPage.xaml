<UserControl x:Class="Re.Desktop.Views.Products.ProductDashboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#EEF1F4">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#AEB8C4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13"/></Style>
  <Style x:Key="KpiTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#667085"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="KpiValue" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,4,0,1"/></Style>
  <Style x:Key="Command" TargetType="Button"><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#0F172A"/><Setter Property="BorderBrush" Value="#98A5B4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel><StackPanel Orientation="Horizontal"><Border Background="#BA0517" Width="5" Margin="0,1,10,1"/><TextBlock Text="Inventory Control Center" FontSize="23" FontWeight="SemiBold" Foreground="#0F172A"/></StackPanel><TextBlock Text="Live stock balance, inventory value, critical levels, and operations" FontSize="12" Foreground="#667085" Margin="15,3,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}" FontSize="11" Foreground="#667085" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Refresh" Command="{Binding LoadCommand}" Style="{StaticResource Command}" Margin="0,0,7,0"/><Button Content="Product Listesi" Command="{Binding NavigateToProductsCommand}" Style="{StaticResource Command}" Margin="0,0,7,0"/><Button Content="Stock Movements" Command="{Binding NavigateToMovementsCommand}" Style="{StaticResource Command}" Background="#0176D3" Foreground="White" BorderBrush="#8F1017"/></StackPanel>
  </Grid>
  <UniformGrid Grid.Row="2" Columns="8">
   <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="TOTAL PRODUCTS" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding TotalProducts, StringFormat='{}{0:N0}'}" Style="{StaticResource KpiValue}"/><TextBlock Text="{Binding ActiveProducts, StringFormat='Active: {0:N0}'}" FontSize="10" Foreground="#667085"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="TOTAL STOCK" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding TotalStockQuantity, StringFormat='{}{0:N2}'}" Style="{StaticResource KpiValue}"/><TextBlock Text="Net of all movements" FontSize="10" Foreground="#667085"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="INVENTORY VALUE" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding TotalStockValue, StringFormat='{}{0:N2} ₺'}" Style="{StaticResource KpiValue}" FontSize="16"/><TextBlock Text="Based on purchase price" FontSize="10" Foreground="#667085"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,6,0" BorderBrush="#FCA5A5"><StackPanel><TextBlock Text="CRITICAL STOCK" Style="{StaticResource KpiTitle}" Foreground="#BA0517"/><TextBlock Text="{Binding CriticalStockCount}" Style="{StaticResource KpiValue}" Foreground="#BA0517"/><TextBlock Text="Below minimum level" FontSize="10" Foreground="#8F1017"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,6,0" BorderBrush="#FCA5A5"><StackPanel><TextBlock Text="OUT OF STOCK" Style="{StaticResource KpiTitle}" Foreground="#BA0517"/><TextBlock Text="{Binding OutOfStockCount}" Style="{StaticResource KpiValue}" Foreground="#BA0517"/><TextBlock Text="Zero balance" FontSize="10" Foreground="#8F1017"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="NEGATIVE STOCK" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding NegativeStockCount}" Style="{StaticResource KpiValue}"/><TextBlock Text="Correction required" FontSize="10" Foreground="#667085"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,6,0"><StackPanel><TextBlock Text="NO MOVEMENT FOR 30 DAYS" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding Inactive30DaysCount}" Style="{StaticResource KpiValue}"/><TextBlock Text="Products without movement" FontSize="10" Foreground="#667085"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TODAY RECEIPTS / ISSUES" Style="{StaticResource KpiTitle}"/><TextBlock Text="{Binding TodayInbound, StringFormat='{}{0:N0} G'}" Style="{StaticResource KpiValue}" FontSize="16"/><TextBlock Text="{Binding TodayOutbound, StringFormat='Issues: {0:N0}'}" FontSize="10" Foreground="#BA0517"/></StackPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <Grid Margin="12,0"><TextBlock Text="Son Stock Movements" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="View All" Command="{Binding NavigateToMovementsCommand}" Style="{StaticResource Command}" Height="27" Padding="10,0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <DataGrid Grid.Row="1" ItemsSource="{Binding RecentMovements}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0" RowHeight="36" AlternatingRowBackground="#F3F5F7" GridLinesVisibility="All" HorizontalGridLinesBrush="#D1D5DB" VerticalGridLinesBrush="#D1D5DB">
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style></DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns><DataGridTextColumn Header="Date / Time" Binding="{Binding MovementDate, StringFormat='dd.MM HH:mm'}" Width="100"/><DataGridTextColumn Header="Transaction" Binding="{Binding TypeName}" Width="115"/><DataGridTextColumn Header="Product Codeu" Binding="{Binding ProductCode}" Width="95"/><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName}" Width="110"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" Width="75"/><DataGridTextColumn Header="Balance" Binding="{Binding StockAfterMovement, StringFormat='{}{0:N2}'}" Width="75"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="1" Text="No stock movements are available yet." Visibility="{Binding HasNoMovements, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#667085"/>
     <Border Grid.Row="2" Background="#E5E7EB" BorderBrush="#AEB8C4" BorderThickness="0,1,0,0"><TextBlock Text="{Binding RecentMovements.Count, StringFormat='Showing the latest {0} movements'}" FontSize="10" Foreground="#4B5563" Margin="9,0" VerticalAlignment="Center"/></Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <Grid Margin="12,0"><TextBlock Text="Critical Inventory and Replenishment Needs" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{Binding CriticalProducts.Count, StringFormat='{}{0} records'}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#BA0517" FontWeight="SemiBold"/></Grid>
     <DataGrid Grid.Row="1" ItemsSource="{Binding CriticalProducts}" SelectedItem="{Binding SelectedCriticalProduct}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0" RowHeight="38" AlternatingRowBackground="#F3F5F7" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D1D5DB">
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#0F172A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8"/></Style></DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Inventory" Binding="{Binding Stock, StringFormat='{}{0:N2}'}" Width="65"/><DataGridTextColumn Header="Min." Binding="{Binding MinStock, StringFormat='{}{0:N2}'}" Width="65"/><DataGridTextColumn Header="Shortage" Binding="{Binding Shortage, StringFormat='{}{0:N2}'}" Width="65"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="1" Text="No products are at critical stock." Visibility="{Binding HasNoCriticalProducts, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#166534" FontWeight="SemiBold"/>
     <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,1,0,0"><TextBlock Text="Minimum stock levels are managed from product cards." FontSize="10" Foreground="#8F1017" Margin="9,0" VerticalAlignment="Center"/></Border>
    </Grid>
   </Border>
   <Border Grid.ColumnSpan="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisibility}}" Background="#DDFFFFFF"><TextBlock Text="Calculating live inventory data..." Foreground="#BA0517" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
  </Grid>
 </Grid>
</UserControl>
