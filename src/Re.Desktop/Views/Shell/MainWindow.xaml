<Window x:Class="Re.Desktop.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Re.Desktop.ViewModels.Shell"
        mc:Ignorable="d"
        Title="Re Business Platform"
        Width="1400" Height="820"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#E0E3E8"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="WindowCommandButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#59616C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Ribbon Buton Stili (Büyük İkon + Alt Metin) -->
        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F2FA"/>
                                <Setter Property="BorderBrush" Value="#C9E0F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CDE6F7"/>
                                <Setter Property="BorderBrush" Value="#92C0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MDI Workspace TabControl Style -->
        <Style x:Key="MdiTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="#0070D2"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- MDI (Çalışma Alanı) TabItem Stili (Sekme + Close Butonu) -->
        <Style x:Key="MdiTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Close This Tab"
                                  Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Close Other Tabs"
                                  Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Close All Tabs"
                                  Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Margin="0,0,10,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsCloseable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="Transparent" BorderThickness="0" Foreground="#999999"
                                    FontWeight="Bold" FontSize="10" Cursor="Hand" Width="16" Height="16"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#D9534F"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#0070D2"/>
                    <Setter Property="Foreground" Value="#0070D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" ClipToBounds="True" Background="#E0E3E8" BorderBrush="#555555" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />     <!-- Pencere Başlığı -->
                <RowDefinition Height="54" />     <!-- Modern Salesforce Header Bar -->
                <RowDefinition Height="*" />      <!-- Sekmeli Çalışma Alanı (MDI TabControl) -->
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <!-- ── PENCERE BAŞLIĞI (Title Bar) ── -->
            <Border Grid.Row="0" Background="#3A3E45" MouseDown="TitleBar_MouseDown">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="file:///C:/Users/ttsy/source/repos/Envanzo/Re_ERP_Logo.ico" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Re Business Platform" FontSize="12" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="{Binding UserFullName}" FontSize="12" Foreground="#CCCCCC" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding CompanyName, StringFormat='[{0}]'}" FontSize="11" Foreground="#999999" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-1,-10,-1">
                        <Button Content="—" Style="{StaticResource WindowCommandButton}" Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>
                        <Button Content="□" Style="{StaticResource WindowCommandButton}" Click="MaximizeButton_Click"
                                ToolTip="Maximize / Restore"/>
                        <Button Content="X" Style="{StaticResource WindowCommandButton}" Click="CloseButton_Click"
                                ToolTip="Close" Background="#B94444" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── SALESFORCE LIGHTNING NAV BAR (Modern Top Navigation with Submenus) ── -->
            <Border Grid.Row="1" Background="White" BorderBrush="#D8DCE2" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- App Launcher Grid -->
                        <ColumnDefinition Width="*"/>    <!-- Navigation Menus -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: 9-Dot App Launcher -->
                    <Button Width="48" Height="53" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard" ToolTip="App Launcher (Dashboard)">
                        <Path Fill="#0070D2" Stretch="Uniform" Width="20" Height="20"
                              Data="M2,2 H4 V4 H2 z M8,2 H10 V4 H8 z M14,2 H16 V4 H14 z M2,8 H4 V10 H2 z M8,8 H10 V10 H8 z M14,8 H16 V10 H14 z M2,14 H4 V16 H2 z M8,14 H10 V16 H8 z M14,14 H16 V16 H14 z"/>
                    </Button>

                    <!-- Center: Navigation Menus with Sub-menus -->
                    <Menu Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Height="53">
                        <Menu.Resources>
                            <!-- Dropdown Arrow Icon -->
                            <ControlTemplate x:Key="DropdownArrowTemplate">
                                <Path Data="M0,0 L3.5,3.5 L7,0 Z" Fill="#54698D" Margin="6,2,0,0" VerticalAlignment="Center"/>
                            </ControlTemplate>

                            <!-- Top Menu Item Style -->
                            <Style TargetType="MenuItem" x:Key="TopMenuItemStyle">
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="Padding" Value="16,16"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="Border" Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide">
                                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" SnapsToDevicePixels="True" Margin="0,4,0,0">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.08" ShadowDepth="3" Direction="270"/>
                                                            </Border.Effect>
                                                            <ScrollViewer CanContentScroll="True">
                                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                                    <Setter Property="Foreground" Value="#0070D2"/>
                                                </Trigger>
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#E2E8F0"/>
                                                    <Setter Property="Foreground" Value="#0070D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Sub Menu Item Style -->
                            <Style TargetType="MenuItem" x:Key="SubMenuItemStyle">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="Padding" Value="16,10"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="SubBorder" Background="Transparent" CornerRadius="4" Margin="2" SnapsToDevicePixels="True" MinWidth="185">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SubBorder" Property="Background" Value="#F1F5F9"/>
                                                    <Setter Property="Foreground" Value="#0070D2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>

                        <!-- Menu 1: Sales Cloud -->
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☁  Sales Cloud" VerticalAlignment="Center"/>
                                    <Control Template="{StaticResource DropdownArrowTemplate}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Dashboard" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                            <MenuItem Header="Accounts (Cari Kartlar)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Accounts"/>
                            <MenuItem Header="Orders (Siparişler)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Orders"/>
                            <MenuItem Header="Calendar (Ajanda)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Agenda"/>
                            <MenuItem Header="Quick Sale (POS)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="POS" Visibility="{Binding IsPosInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </MenuItem>

                        <!-- Menu 2: Invoices -->
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄  Invoices" VerticalAlignment="Center"/>
                                    <Control Template="{StaticResource DropdownArrowTemplate}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Sales Invoices (Satış)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Invoices"/>
                            <MenuItem Header="Purchase Invoices (Alış)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Invoices"/>
                            <MenuItem Header="Return Invoices (İade)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Invoices"/>
                            <MenuItem Header="Exchange Invoices (Değişim)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Invoices"/>
                            <MenuItem Header="Price Difference (Fiyat Farkı)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Invoices"/>
                        </MenuItem>

                        <!-- Menu 3: Inventory -->
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦  Inventory" VerticalAlignment="Center"/>
                                    <Control Template="{StaticResource DropdownArrowTemplate}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Stock Panel (Özet)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="ProductDashboard"/>
                            <MenuItem Header="Products (Ürün Kartları)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Products"/>
                            <MenuItem Header="Stock Movements" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="StockMovements"/>
                            <MenuItem Header="Purchases (Alış İrsaliyeleri)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="PurchaseInvoices"/>
                        </MenuItem>

                        <!-- Menu 4: Finance -->
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💰  Finance" VerticalAlignment="Center"/>
                                    <Control Template="{StaticResource DropdownArrowTemplate}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Cash Register (Kasa)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Cash"/>
                            <MenuItem Header="Bank Accounts (Banka)" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Bank"/>
                            <MenuItem Header="Collections &amp; Payments" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Finance"/>
                            <MenuItem Header="Funding Intelligence AI" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="FundingIntelligence" Visibility="{Binding IsFundingInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </MenuItem>

                        <!-- Menu 5: Salesforce CRM -->
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☁  Salesforce CRM" VerticalAlignment="Center"/>
                                    <Control Template="{StaticResource DropdownArrowTemplate}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Salesforce LWC Cloud" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="SalesforceCloud"/>
                        </MenuItem>

                        <!-- Menu 6: Setup -->
                        <MenuItem Style="{StaticResource TopMenuItemStyle}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙  Setup" VerticalAlignment="Center"/>
                                    <Control Template="{StaticResource DropdownArrowTemplate}"/>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem Header="Settings" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                            <MenuItem Header="Packages" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="PackageCenter"/>
                            <MenuItem Header="Updates" Style="{StaticResource SubMenuItemStyle}" Command="{Binding NavigateCommand}" CommandParameter="UpdateCenter"/>
                            <Separator/>
                            <MenuItem Header="Sign Out" Style="{StaticResource SubMenuItemStyle}" Command="{Binding LogoutCommand}"/>
                        </MenuItem>
                    </Menu>
                </Grid>
            </Border>

            <!-- ── ÇALIŞMA ALANI (MDI Tabs) ── -->
            <TabControl Grid.Row="2" Style="{StaticResource MdiTabControlStyle}" ItemContainerStyle="{StaticResource MdiTabItemStyle}"
                        ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding ActiveTab}">

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <!-- İçerik burada (Page/UserControl) gösterilecek -->
                        <ContentControl Content="{Binding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <Border Grid.Row="3" Background="#032D60" BorderBrush="#021B3D" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Connection Status Pill -->
                        <ColumnDefinition Width="Auto"/> <!-- Session User Pill -->
                        <ColumnDefinition Width="Auto"/> <!-- Windows User Pill -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Local IP Pill -->
                        <ColumnDefinition Width="Auto"/> <!-- Live Clock Pill -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Connection Status Pill -->
                    <Border Background="#10B981" CornerRadius="4" Padding="8,2" Margin="0,3,10,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Session User Pill -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="0,3,10,3" VerticalAlignment="Center" Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding SessionUsername}" Foreground="#E2E8F0" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Windows User Pill -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="0,3,10,3" VerticalAlignment="Center" Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💻" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding WindowsUser}" Foreground="#E2E8F0" FontSize="10.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Local IP Pill -->
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,2" Margin="0,3,10,3" VerticalAlignment="Center" Grid.Column="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding LocalIpAddress, StringFormat='IP: {0}'}" Foreground="#E2E8F0" FontSize="10.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Clock Pill -->
                    <Border Background="#014486" CornerRadius="4" Padding="8,2" Margin="0,3,0,3" VerticalAlignment="Center" Grid.Column="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" Foreground="#9ED7FF" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding LiveClock}" Foreground="White" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
