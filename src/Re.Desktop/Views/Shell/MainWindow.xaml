<Window x:Class="Re.Desktop.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Re.Desktop.ViewModels.Shell"
        mc:Ignorable="d"
        Title="Re Business Platform"
        Width="1400" Height="820"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#E0E3E8"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="WindowCommandButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#59616C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Ribbon Buton Stili (Büyük İkon + Alt Metin) -->
        <Style x:Key="RibbonButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6F2FA"/>
                                <Setter Property="BorderBrush" Value="#C9E0F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CDE6F7"/>
                                <Setter Property="BorderBrush" Value="#92C0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MDI Workspace TabControl Style -->
        <Style x:Key="MdiTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#F5F6F8"/>
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
            <Setter Property="BorderBrush" Value="#0070D2"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- MDI (Çalışma Alanı) TabItem Stili (Sekme + Kapat Butonu) -->
        <Style x:Key="MdiTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Close This Tab"
                                  Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Close Other Tabs"
                                  Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Close All Tabs"
                                  Command="{Binding PlacementTarget.Tag.CloseAllTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Margin="0,0,10,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="✕" 
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsCloseable, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="Transparent" BorderThickness="0" Foreground="#999999" 
                                    FontWeight="Bold" FontSize="10" Cursor="Hand" Width="16" Height="16"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#D9534F"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#0070D2"/>
                    <Setter Property="Foreground" Value="#0070D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" ClipToBounds="True" Background="#E0E3E8" BorderBrush="#555555" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />     <!-- Pencere Başlığı -->
                <RowDefinition Height="100" />    <!-- Ribbon Menü (TabControl) -->
                <RowDefinition Height="*" />      <!-- Sekmeli Çalışma Alanı (MDI TabControl) -->
                <RowDefinition Height="25" />
            </Grid.RowDefinitions>

            <!-- ── PENCERE BAŞLIĞI (Title Bar) ── -->
            <Border Grid.Row="0" Background="#3A3E45" MouseDown="TitleBar_MouseDown">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="file:///C:/Users/ttsy/source/repos/Envanzo/Re_ERP_Logo.ico" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Re Business Platform" FontSize="12" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="{Binding UserFullName}" FontSize="12" Foreground="#CCCCCC" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding CompanyName, StringFormat='[{0}]'}" FontSize="11" Foreground="#999999" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-1,-10,-1">
                        <Button Content="—" Style="{StaticResource WindowCommandButton}" Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>
                        <Button Content="□" Style="{StaticResource WindowCommandButton}" Click="MaximizeButton_Click"
                                ToolTip="Maximize / Restore"/>
                        <Button Content="X" Style="{StaticResource WindowCommandButton}" Click="CloseButton_Click"
                                ToolTip="Close" Background="#B94444" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── SALESFORCE APPLAUNCHER-STYLE RIBBON MENÜ ── -->
            <TabControl Grid.Row="1" Background="#FAFBFC" BorderThickness="0,0,0,1" BorderBrush="#D8DCE2">
                <TabControl.Resources>
                    <!-- Salesforce Lightning Sekme Başlıkları Stili -->
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="18,6"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#3E3E3C"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FAFBFC"/>
                                <Setter Property="Foreground" Value="#0070D2"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- ☁️ Sales Cloud (ERP + CRM Harmanı) -->
                <TabItem Header="☁ Sales Cloud">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#0070D2" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M13,3V11H21V3H13M3,13V21H11V13H3M3,3V11H11V3H3M13,13V21H21V13H13Z"/>
                                <TextBlock Text="Dashboard" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Accounts" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#7C3AED" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                                <TextBlock Text="Accounts" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Invoices" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#D83B01" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M16,11V13H8V11H16M16,15V17H8V15H16Z"/>
                                <TextBlock Text="Invoices" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="POS" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#107C10" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M17,18C15.89,18 15,18.89 15,20A2,2 0 0,0 17,22A2,2 0 0,0 19,20C19,18.89 18.1,18 17,18M1,2V4H3L6.6,11.59L5.24,14.04C5.09,14.32 5,14.65 5,15A2,2 0 0,0 7,17H19V15H7.42A0.25,0.25 0 0,1 7.17,14.75L7.2,14.63L8.1,13H15.55C16.3,13 16.96,12.58 17.3,11.97L20.88,5.5C20.95,5.34 21,5.17 21,5A1,1 0 0,0 20,4H5.21L4.27,2M7,18C5.89,18 5,18.89 5,20A2,2 0 0,0 7,22A2,2 0 0,0 9,20C9,18.89 8.1,18 7,18Z"/>
                                <TextBlock Text="Quick Sale" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,8"/>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Agenda" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#E3008C" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3.01,4.9 3.01,6L3,20C3,21.1 3.89,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4M19,20H5V10H19V20M19,8H5V6H19V8M14,14H12V12H14V14M18,14H16V12H18V14M10,14H8V12H10V14M14,18H12V16H14V18M18,18H16V16H18V18M10,18H8V16H10V18Z"/>
                                <TextBlock Text="Calendar" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- 📦 Stok & Ürün Yönetimi -->
                <TabItem Header="📦 Inventory">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="ProductDashboard" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#0070D2" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M13,3V11H21V3H13M3,13V21H11V13H3M3,3V11H11V3H3M13,13V21H21V13H13Z"/>
                                <TextBlock Text="Stock Panel" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Products" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#2B579A" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M12,3L1,9L4,10.63V17L12,21.5L20,17V10.63L23,9M12,5.16L19.85,9.33L12,13.5L4.15,9.33M5.5,12.2V16.03L12,19.68L18.5,16.03V12.2L12,15.85Z"/>
                                <TextBlock Text="Products" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="StockMovements" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#217346" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,13.97 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z"/>
                                <TextBlock Text="Movements" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- 💰 Finans -->
                <TabItem Header="💰 Finance">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Cash" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#107C10" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M3,6H21V18H3V6M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9M7,8A2,2 0 0,1 5,10V14A2,2 0 0,1 7,16H17A2,2 0 0,1 19,14V10A2,2 0 0,1 17,8H7Z"/>
                                <TextBlock Text="Cash" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Bank" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#C62828" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M11.5,1L2,6V8H21V6M16,10V17H19V10M2,22H21V19H2M10,10V17H13V10M4,10V17H7V10Z"/>
                                <TextBlock Text="Bank" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Finance" Width="90">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#D83B01" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,17H13V16H14A1,1 0 0,0 15,15V12A1,1 0 0,0 14,11H11V9H15V7H13V6H11V7H10A1,1 0 0,0 9,8V11A1,1 0 0,0 10,12H13V14H9V16H11V17Z"/>
                                <TextBlock Text="Payments" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- ☁ Salesforce Cloud (CRM) -->
                <TabItem Header="☁ Salesforce CRM">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SalesforceCloud" Width="110" ToolTip="Salesforce Lightning LWC Workspace">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#00A1E0" Stretch="Uniform" Width="28" Height="24" Margin="0,0,0,4" Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z"/>
                                <TextBlock Text="Salesforce Cloud" FontSize="10" FontWeight="Bold" Foreground="#0070D2" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- 📊 Raporlar & Analytics -->
                <TabItem Header="📊 Reports">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Reports" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#444444" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M22,21H2V3H4V19H22V21M18,17H14V11H18V17M12,17H8V5H12V17M6,17H2V14H6V17Z"/>
                                <TextBlock Text="Reports" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>

                <!-- ⚙ Setup -->
                <TabItem Header="⚙ Setup">
                    <StackPanel Orientation="Horizontal" Margin="8,4">
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#54698D" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.65 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.35 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98Z"/>
                                <TextBlock Text="Settings" FontSize="10" Foreground="#3E3E3C" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,8"/>
                        <Button Style="{StaticResource RibbonButtonStyle}" Command="{Binding LogoutCommand}" Width="82">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Fill="#C23934" Stretch="Uniform" Width="24" Height="24" Margin="0,0,0,4" Data="M17,17.25V14H10V10H17V6.75L22.25,12L17,17.25M13,2A2,2 0 0,1 15,4V8H13V4H4V20H13V16H15V20A2,2 0 0,1 13,22H4A2,2 0 0,1 2,20V4A2,2 0 0,1 4,2H13Z"/>
                                <TextBlock Text="Sign Out" FontSize="10" Foreground="#C23934" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- ── ÇALIŞMA ALANI (MDI Tabs) ── -->
            <TabControl Grid.Row="2" Style="{StaticResource MdiTabControlStyle}" ItemContainerStyle="{StaticResource MdiTabItemStyle}"
                        ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding ActiveTab}">
                
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <!-- İçerik burada (Page/UserControl) gösterilecek -->
                        <ContentControl Content="{Binding Content}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <Border Grid.Row="3" Background="#032D60" BorderBrush="#021B3D" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding SessionUsername, StringFormat='  User: {0}'}" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding WindowsUser, StringFormat='  Windows: {0}'}" Foreground="#FFE5E5" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding LocalIpAddress, StringFormat='IP: {0}'}" Foreground="#FFE5E5" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Grid.Column="5" Text="{Binding LiveClock}" Foreground="White" FontFamily="Consolas" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
