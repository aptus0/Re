<UserControl x:Class="Re.Desktop.Views.Shell.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Re.Desktop.ViewModels.Shell"
             d:DataContext="{d:DesignInstance Type=shell:DashboardViewModel, IsDesignTimeCreatable=False}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="#F5F6F8" Loaded="DashboardPage_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Genel Bakış" FontSize="26" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Sisteminizin anlık finansal ve operasyonel durumu" FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Button Command="{Binding LoadDashboardCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,8" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" 
                          Stroke="#374151" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Yenile" Foreground="#374151" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Sol Taraf: Kartlar ve Diğer Özetler -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Finansal Özet Kartları -->
                <UniformGrid Columns="2" Rows="2" VerticalAlignment="Top">
                    <!-- Kasa Bakiye -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Toplam Kasa Bakiye" FontSize="13" Foreground="#6B7280" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TotalCashBalance, StringFormat=N2 ₺}" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Background="#ECFDF5" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" 
                                      Stroke="#059669" StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Banka Bakiye -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" Margin="10,0,0,10">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Toplam Banka Bakiye" FontSize="13" Foreground="#6B7280" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TotalBankBalance, StringFormat=N2 ₺}" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Background="#EFF6FF" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" 
                                      Stroke="#2563EB" StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Toplam Alacak -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" Margin="0,10,10,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Toplam Alacaklar" FontSize="13" Foreground="#6B7280" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TotalReceivables, StringFormat=N2 ₺}" FontSize="28" FontWeight="Bold" Foreground="#047857" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Background="#ECFDF5" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" Stroke="#059669" StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Toplam Borç -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" Margin="10,10,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Toplam Borçlar" FontSize="13" Foreground="#6B7280" FontWeight="Medium"/>
                                <TextBlock Text="{Binding TotalPayables, StringFormat=N2 ₺}" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Border Background="#FEF2F2" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" Stroke="#DC2626" StrokeThickness="2" Stretch="Uniform" Width="24" Height="24"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Operasyonel Özet (Satış & Cari) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Bu Ayki Satışlar" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                            <TextBlock Text="{Binding CurrentMonthSalesTotal, StringFormat=N2 ₺}" FontSize="32" FontWeight="Bold" Foreground="#0284C7" Margin="0,15,0,0"/>
                            <TextBlock Foreground="#6B7280" Margin="0,5,0,0">
                                <Run Text="Toplam "/>
                                <Run Text="{Binding CurrentMonthSalesCount}" FontWeight="Bold" Foreground="#374151"/>
                                <Run Text=" fatura kesildi."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Cari Hesaplar" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                            <TextBlock Text="{Binding TotalAccountCount}" FontSize="32" FontWeight="Bold" Foreground="#0284C7" Margin="0,15,0,0"/>
                            <TextBlock Text="Sistemde kayıtlı toplam cari / müşteri sayısı" Foreground="#6B7280" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>

            <!-- Sağ Taraf: Son İşlemler (Timeline) -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20">
                        <TextBlock Text="Son İşlem Geçmişi" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,10">
                        <ItemsControl ItemsSource="{Binding RecentTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- İkon -->
                                            <Border Width="40" Height="40" CornerRadius="20" Background="#F3F4F6" Margin="0,0,15,0">
                                                <TextBlock Text="✦" Foreground="#9CA3AF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="Medium" Foreground="#111827" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TransactionType}" FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text=" • " FontSize="12" Foreground="#D1D5DB"/>
                                                    <TextBlock Text="{Binding Date, StringFormat=dd MMM HH:mm}" FontSize="12" Foreground="#6B7280"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat=N2 ₺}" 
                                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncome}" Value="False">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
        </Grid>
        
        <!-- Yükleniyor Göstergesi -->
        <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Veriler Alınıyor..." FontSize="16" FontWeight="Medium" Foreground="#0078D4"/>
            </StackPanel>
        </Border>
        
    </Grid>
</UserControl>
