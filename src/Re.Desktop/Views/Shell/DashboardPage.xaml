<UserControl x:Class="Re.Desktop.Views.Shell.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:Re.Desktop.ViewModels.Shell"
             d:DataContext="{d:DesignInstance Type=shell:DashboardViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" Background="#F4F6F9" Loaded="DashboardPage_Loaded">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <Grid Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Management Center" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Live summary of finance, sales, and inventory operations"
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Command="{Binding LoadDashboardCommand}" Content="↻  Refresh"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="16,9" Background="#0176D3" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TODAY'S COLLECTIONS" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TodayCollections, StringFormat={}{0:N2} ₺}"
                                       Style="{StaticResource KpiValue}" Foreground="#15803D"/>
                            <TextBlock Text="Cash and bank receipts" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TODAY'S PAYMENTS" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TodayPayments, StringFormat={}{0:N2} ₺}"
                                       Style="{StaticResource KpiValue}" Foreground="#DC2626"/>
                            <TextBlock Text="Cash and bank payments" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="SALES THIS MONTH" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding CurrentMonthSalesTotal, StringFormat={}{0:N2} ₺}"
                                       Style="{StaticResource KpiValue}" Foreground="#0176D3"/>
                            <TextBlock FontSize="11" Foreground="#64748B" Margin="0,6,0,0">
                                <Run Text="{Binding CurrentMonthSalesCount}"/><Run Text=" invoices · change "/>
                                <Run Text="{Binding SalesChangePercent, StringFormat={}{0:N1}%}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="OVERDUE" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding OverdueInvoiceTotal, StringFormat={}{0:N2} ₺}"
                                       Style="{StaticResource KpiValue}" Foreground="#B91C1C"/>
                            <TextBlock Text="{Binding OverdueInvoiceCount, StringFormat={}{0} open invoices}"
                                       Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="CASH BALANCE" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TotalCashBalance, StringFormat={}{0:N2} ₺}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="BANK BALANCE" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TotalBankBalance, StringFormat={}{0:N2} ₺}" Style="{StaticResource KpiValue}"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="RECEIVABLES" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TotalReceivables, StringFormat={}{0:N2} ₺}" Style="{StaticResource KpiValue}" Foreground="#15803D"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel><TextBlock Text="PAYABLES" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{Binding TotalPayables, StringFormat={}{0:N2} ₺}" Style="{StaticResource KpiValue}" Foreground="#DC2626"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Action Center" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Priority work queues" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,10"/>
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="#F59E0B" CornerRadius="4" Margin="0,1,0,1"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Operations Metrics" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,14"><TextBlock Text="Critical stock" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding CriticalStockCount}" Style="{StaticResource KpiValue}" Foreground="#D97706"/></StackPanel>
                                <StackPanel Margin="10,0,0,14"><TextBlock Text="Out of stock" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding OutOfStockCount}" Style="{StaticResource KpiValue}" Foreground="#DC2626"/></StackPanel>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Draft fatura" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding DraftInvoiceCount}" Style="{StaticResource KpiValue}" Foreground="#0176D3"/></StackPanel>
                                <StackPanel Margin="10,0,0,0"><TextBlock Text="Total accounts" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock Text="{Binding TotalAccountCount}" Style="{StaticResource KpiValue}"/></StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Six-Month Sales Trend" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SalesTrend}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Period}" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:N2} ₺}"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Top-Selling Products" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding TopProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#94A3B8"><Run Text="{Binding ProductCode}"/><Run Text=" · "/><Run Text="{Binding Quantity, StringFormat={}{0:N2} adet}"/></TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Revenue, StringFormat={}{0:N2} ₺}" FontWeight="Bold" Foreground="#0176D3" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Recent Activity" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding RecentTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TransactionType}" FontSize="11" Foreground="#94A3B8"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat={}{0:N2} ₺}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Background="#99FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Preparing dashboard..." FontWeight="SemiBold" Foreground="#0176D3"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
