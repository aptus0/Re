<Window x:Class="Re.Desktop.Views.Salesforce.SalesforceMetadataStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salesforce Developer &amp; Deployment Studio" Height="750" Width="1050"
        WindowStartupLocation="CenterOwner" Background="#F1F5F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🛠️ Salesforce Developer &amp; Deployment Studio" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Custom objects, validation rules, flow automation, and API operations." Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Click="CloseButton_Click" Width="90" Height="34" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Custom Objects -->
            <TabItem Header="📦 Custom Object Studio">
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="New Salesforce Custom Objectsi (Custom Object)" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Obje Etiketi (Label)" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtObjectLabel" Text="ERP Invoice Header" Padding="10,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="API Name (__c)" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtObjectApiName" Text="ERP_Invoice_Header__c" Padding="10,8"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Description &amp; Integration Notes" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtObjectDescription" Text="Invoice header records transferred from the ERP system." Padding="10,8" Margin="0,0,0,20"/>
                        <Button Content="🚀 Objeyi Org'a Deploy Et" Click="DeployObject_Click" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 2: Validation Rules -->
            <TabItem Header="🛡️ Validation Rules">
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Record Validation Rule" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Rule Name" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtRuleName" Text="Require_Tax_Number_On_Account" Padding="10,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hedef Obje" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtRuleObject" Text="Account" Padding="10,8"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Error Condition Formula" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtRuleFormula" Text="ISBLANK(Tax_Number__c)" Padding="10,8" Margin="0,0,0,14"/>
                        <TextBlock Text="Displayed Error Message" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtRuleErrorMessage" Text="Tax Number is required for account records." Padding="10,8" Margin="0,0,0,20"/>
                        <Button Content="🛡️ Deploy Rule to Org" Click="DeployRule_Click" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 3: Flows -->
            <TabItem Header="⚡ Flow &amp; Otomasyon">
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Salesforce Automation Flow (Record-Triggered Flow)" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Flow Name" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtFlowName" Text="ERP_Auto_Invoice_Approval_Flow" Padding="10,8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tetikleyici Obje" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtFlowTrigger" Text="Opportunity" Padding="10,8"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="⚡ Deploy Flow to Org &amp; Activate" Click="DeployFlow_Click" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
