<Window x:Class="Re.Desktop.Views.Salesforce.SalesforceGeminiStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gemini AI Prompt-to-Deploy Stüdyosu" Height="720" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="10" Padding="20,16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✨" FontSize="24" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Gemini AI Prompt-to-Deploy Stüdyosu (MCP Gateway)" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Doğal dil istemleri yazarak Salesforce Obje, Validation Rule ve Flow'larını otomatik oluşturun." Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Kapat" Click="CloseButton_Click" Width="90" Height="34" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Prompt Input Form -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="💬 Gemini AI Doğal Dil İsteminiz (Prompt)" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBox x:Name="TxtPrompt" TextWrapping="Wrap" AcceptsReturn="True" Height="140" Padding="12" Foreground="#0F172A" Background="#F1F5F9" BorderBrush="#CBD5E1"
                             Text="Otomotiv sektörü için Garanti Başlangıç Tarihi zorunlu olan ve Vergi Numarası boş geçilemeyen bir Validation Rule ve Custom Object üret." FontSize="13"/>

                    <TextBlock Text="Hedef Metadata Türü" FontWeight="SemiBold" Foreground="#475569" FontSize="12" Margin="0,14,0,6"/>
                    <ComboBox x:Name="CmbTargetType" SelectedIndex="0" Padding="10,8">
                        <ComboBoxItem Content="CustomObject (Özel Nesne)"/>
                        <ComboBoxItem Content="ValidationRule (Doğrulama Kuralı)"/>
                        <ComboBoxItem Content="FlowAutomation (Otomasyon Akışı)"/>
                    </ComboBox>

                    <Button Content="✨ Gemini AI ile JSON Üret ve MCP ile Deploy Et" Click="GenerateAndDeploy_Click" Margin="0,20,0,0" Height="42" Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Right: JSON & MCP Execution Live Output -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📄 Üretilen JSON Metadata &amp; MCP Gateway Çıktısı" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                    <TextBox x:Name="TxtJsonOutput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Foreground="#4ADE80" Background="#020617" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="12"
                             Text="{Binding DefaultJsonOutput, FallbackValue='[READY] Gemini AI &amp; MCP Server Gateway isteminizi bekliyor...'}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
