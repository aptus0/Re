<UserControl x:Class="Re.Desktop.Views.Salesforce.SalesforceCloudPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Background="#F8FAFC">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>

  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#1E293B"/>
   <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#0070D2"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="16,9"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
   <Setter Property="Background" Value="#E2E8F0"/>
   <Setter Property="Foreground" Value="#334155"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="14,9"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>

 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/> <!-- 0. Header -->
   <RowDefinition Height="*"/>    <!-- 1. Main WebView Workspace -->
   <RowDefinition Height="Auto"/> <!-- 2. Bottom Status Bar -->
  </Grid.RowDefinitions>

  <!-- 0. Executive Header Bar -->
  <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,9">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Path Fill="#00A1E0" Stretch="Uniform" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z"/>
     <StackPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{DynamicResource Salesforce.Title}" FontSize="16" FontWeight="Bold" Foreground="#0070D2" Margin="0,0,8,0"/>
      </StackPanel>
      <TextBlock Text="{DynamicResource Salesforce.Subtitle}" Foreground="#64748B" FontSize="11"/>
     </StackPanel>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="{DynamicResource Salesforce.Gemini}" Command="{Binding OpenGeminiStudioModalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/>
     <Button Content="{DynamicResource Salesforce.Developer}" Command="{Binding OpenMetadataStudioModalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/>
     <Button Content="{DynamicResource Salesforce.NewProposal}" Command="{Binding CreateProposalCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
     <Button Content="{DynamicResource Salesforce.Refresh}" Click="ReloadBrowser_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"
             ToolTip="Refresh the Salesforce page"/>
     <Button Content="{DynamicResource Salesforce.ResetSession}" Click="ResetSalesforceSession_Click" Style="{StaticResource SecondaryButton}"
             ToolTip="Clears saved Salesforce cookies so you can switch accounts"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- 1. Full-Height WebView (Direct Salesforce Login) -->
  <Grid Grid.Row="1" Background="#E2E8F0">
   <!-- Active WebView - always shown, navigates to login.salesforce.com by default -->
   <Border Margin="7" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5">
    <wv2:WebView2 x:Name="SfWebView" Margin="1"/>
   </Border>

   <!-- Fallback state if WebViewUrl is null -->
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <StackPanel.Style>
     <Style TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding WebViewUrl}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </StackPanel.Style>
    <Border Background="White" CornerRadius="16" Padding="48" Width="520">
     <Border.Effect>
      <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="24" ShadowDepth="6"/>
     </Border.Effect>
     <StackPanel HorizontalAlignment="Center">
      <Path Fill="#00A1E0" Stretch="Uniform" Width="64" Height="64" Margin="0,0,0,20" HorizontalAlignment="Center" Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04Z"/>
      <TextBlock Text="{DynamicResource Salesforce.ConnectionReady}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
      <TextBlock Text="{DynamicResource Salesforce.ConnectionHelp}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#64748B" FontSize="14" Margin="0,12,0,24"/>
      <Button Content="{DynamicResource Salesforce.Connect}" Command="{Binding LoginSalesforceCommand}" Style="{StaticResource PrimaryButton}" Padding="24,12" FontSize="14" HorizontalAlignment="Center"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </Grid>

  <!-- 2. Bottom Live Status Bar -->
  <Border Grid.Row="2" Background="#0F172A" Padding="12,7">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0"/>
     <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Right Status -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{DynamicResource Salesforce.DesktopMode}" Foreground="#94A3B8" FontSize="11" Margin="0,0,14,0"/>
     <TextBlock Text="Persistent profile | Local cache | Secure session" Foreground="#64748B" FontSize="11"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
