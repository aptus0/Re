<UserControl x:Class="Re.Desktop.Views.POS.PosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8DDE6"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style x:Key="BlueButton" TargetType="Button">
            <Setter Property="Background" Value="#0176D3"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Re Connected POS &amp; Cash" FontSize="21" FontWeight="Bold" Foreground="#181818"/>
                    <TextBlock Text="One transaction links invoice, stock, customer balance and cash register." Foreground="#60758A" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Product sale mode" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <CheckBox IsChecked="{Binding IsProductSaleEnabled}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding IsProductSaleEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.65*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="170"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" FontSize="13"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedWarehouse, Mode=OneWay}" Visibility="Collapsed"/>
                        <TextBlock Text="Search barcode, code or product name" IsHitTestVisible="False" Foreground="#8996A5" Margin="12,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding ProductResults}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                        <DataGrid.InputBindings><MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddProductCommand}" CommandParameter="{Binding SelectedProduct}"/></DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockLevel, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding SalePrice, StringFormat=₺{0:N2}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="95" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                            <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=₺{0:N2}}" Width="105" IsReadOnly="True"/>
                            <DataGridTextColumn Header="VAT" Binding="{Binding VatRate, StringFormat={}{0}%}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=₺{0:N2}}" Width="110" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Button Content="×" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="#C23934" Background="Transparent" BorderThickness="0" FontSize="16"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="SALE CONTEXT" FontSize="11" FontWeight="Bold" Foreground="#60758A"/>
                        <TextBlock Text="{Binding DocumentNumber}" Foreground="#0176D3" FontWeight="SemiBold" Margin="0,5,0,12"/>
                        <TextBlock Text="Customer" FontSize="11" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Margin="0,4,0,9"/>
                        <TextBlock Text="Warehouse" FontSize="11" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Margin="0,4,0,9"/>
                        <TextBlock Text="Payment method" FontSize="11" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,4,0,9"/>
                        <TextBlock Text="Cash register" FontSize="11" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding SelectedCashRegister}" DisplayMemberPath="Name" Margin="0,4,0,9"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <Grid Margin="0,5"><TextBlock Text="Items" Foreground="#60758A"/><TextBlock Text="{Binding ItemCount}" HorizontalAlignment="Right" FontWeight="Bold"/></Grid>
                        <Grid Margin="0,5"><TextBlock Text="Subtotal" Foreground="#60758A"/><TextBlock Text="{Binding SubTotal, StringFormat=₺{0:N2}}" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,5"><TextBlock Text="VAT" Foreground="#60758A"/><TextBlock Text="{Binding TaxTotal, StringFormat=₺{0:N2}}" HorizontalAlignment="Right"/></Grid>
                        <Border Background="#032D60" Padding="12" Margin="0,10,0,0"><Grid><TextBlock Text="TOTAL" Foreground="White" FontWeight="Bold"/><TextBlock Text="{Binding GrandTotal, StringFormat=₺{0:N2}}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"/></Grid></Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="Complete sale" Command="{Binding CompleteSaleCommand}" Style="{StaticResource BlueButton}" Height="44"/>
                        <Button Content="Clear cart" Command="{Binding ClearSaleCommand}" Margin="0,7,0,0" Padding="10,7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24" MaxWidth="720"
                Visibility="{Binding IsCashOperationMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Cash-only operation" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Use this mode when product sale and stock movement are not required. The collection is still linked to the customer account and cash register." Foreground="#60758A" TextWrapping="Wrap" Margin="0,5,0,20"/>
                <TextBlock Text="Customer account" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Margin="0,5,0,12"/>
                <TextBlock Text="Cash register" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding SelectedCashRegister}" DisplayMemberPath="Name" Margin="0,5,0,12"/>
                <TextBlock Text="Amount" FontWeight="SemiBold"/><TextBox Text="{Binding CashTransactionAmount}" Padding="9" Margin="0,5,0,12"/>
                <TextBlock Text="Description" FontWeight="SemiBold"/><TextBox Text="{Binding CashTransactionDescription}" Height="65" TextWrapping="Wrap" AcceptsReturn="True" Padding="9" Margin="0,5,0,16"/>
                <Button Content="Record collection" Command="{Binding SaveCashOperationCommand}" Style="{StaticResource BlueButton}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
