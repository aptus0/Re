<UserControl x:Class="Re.Desktop.Views.POS.PosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F2F2">
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Border Background="White" BorderBrush="#AFAFAF" BorderThickness="1" Height="40">
                    <Grid><TextBlock Text="Barkod veya ürün adı" Foreground="#777" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBox Background="Transparent" Foreground="#171717" BorderThickness="0" Padding="12,0" FontSize="13" VerticalContentAlignment="Center"/></Grid>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,5,4">
                    <Button Content="Müşteri Seç" Style="{StaticResource CorporateButton}" Margin="0,0,6,0"/>
                    <Button Content="Bekleyen Satışlar" Style="{StaticResource CorporateButton}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource CorporateSurface}" Padding="0">
                <DataGrid Style="{StaticResource CorporateDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ürün Kodu" Width="110"/>
                        <DataGridTextColumn Header="Ürün Adı" Width="*"/>
                        <DataGridTextColumn Header="Miktar" Width="80"/>
                        <DataGridTextColumn Header="Birim" Width="75"/>
                        <DataGridTextColumn Header="Birim Fiyat" Width="105"/>
                        <DataGridTextColumn Header="İskonto" Width="85"/>
                        <DataGridTextColumn Header="KDV" Width="65"/>
                        <DataGridTextColumn Header="Tutar" Width="110"/>
                        <DataGridTextColumn Header="" Width="45"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <UniformGrid Grid.Row="4" Columns="6">
                <Button Content="F2 · Ürün Ara" Style="{StaticResource CorporateButton}" Margin="0,0,5,0"/>
                <Button Content="F3 · Miktar" Style="{StaticResource CorporateButton}" Margin="0,0,5,0"/>
                <Button Content="F4 · İskonto" Style="{StaticResource CorporateButton}" Margin="0,0,5,0"/>
                <Button Content="F6 · Satışı Beklet" Style="{StaticResource CorporateButton}" Margin="0,0,5,0"/>
                <Button Content="F8 · İade" Style="{StaticResource CorporateButton}" Margin="0,0,5,0"/>
                <Button Content="ESC · Temizle" Style="{StaticResource CorporateButton}"/>
            </UniformGrid>
        </Grid>
        <Border Grid.Column="2" Background="White" BorderBrush="#B8B8B8" BorderThickness="1">
            <Grid Margin="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SATIŞ ÖZETİ" FontSize="13" FontWeight="Bold" Foreground="#202124"/>
                    <TextBlock Text="Belge: POS-2026-000184" FontSize="10" Foreground="#777" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#D2D2D2" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,9"><TextBlock Text="Ürün adedi" Foreground="#555"/><TextBlock Text="0" HorizontalAlignment="Right" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,0,0,9"><TextBlock Text="Ara toplam" Foreground="#555"/><TextBlock Text="0,00 ₺" HorizontalAlignment="Right"/></Grid>
                        <Grid Margin="0,0,0,9"><TextBlock Text="İskonto" Foreground="#555"/><TextBlock Text="0,00 ₺" HorizontalAlignment="Right"/></Grid>
                        <Grid><TextBlock Text="KDV toplamı" Foreground="#555"/><TextBlock Text="0,00 ₺" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                    <TextBlock Text="Ödeme Yöntemi" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <UniformGrid Columns="2" Rows="2">
                        <Button Content="Nakit" Style="{StaticResource CorporateButton}" Margin="0,0,5,5"/>
                        <Button Content="Kredi Kartı" Style="{StaticResource CorporateButton}" Margin="0,0,0,5"/>
                        <Button Content="Karma Ödeme" Style="{StaticResource CorporateButton}" Margin="0,0,5,0"/>
                        <Button Content="Açık Hesap" Style="{StaticResource CorporateButton}"/>
                    </UniformGrid>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <Border Background="#202124" Padding="12">
                        <Grid><TextBlock Text="GENEL TOPLAM" Foreground="White" FontSize="13" FontWeight="Bold"/><TextBlock Text="0,00 ₺" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/></Grid>
                    </Border>
                    <Button Content="F12 · ÖDEME AL" Style="{StaticResource CorporatePrimaryButton}" Height="48" FontSize="15" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
