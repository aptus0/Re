<UserControl x:Class="Re.Desktop.Views.Sales.InvoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sales="clr-namespace:Re.Desktop.ViewModels.Sales"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=sales:InvoiceListViewModel, IsDesignTimeCreatable=False}"
             Background="#F5F6F8">

    <Grid>
        <!-- Ana Liste Görünümü -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Üst Searchç Çubuğu (Ribbon Tarzı) -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sales Invoices" FontSize="24" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center" Margin="0,0,30,0"/>

                        <!-- Searchma Kutusu -->
                        <Border Background="#F3F4F6" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Width="300" Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                      Stroke="#9CA3AF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="16" Height="16" Stretch="Uniform" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14" Foreground="#374151"
                                         VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="Search invoice number or account..." Foreground="#9CA3AF" FontSize="14"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"
                                           Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Aksiyon Butonları -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding NewInvoiceCommand}"
                                Background="#0078D4" Foreground="White" BorderThickness="0" Padding="16,8"
                                FontSize="14" FontWeight="Medium" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M12 4v16m8-8H4" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="New Invoice" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#0176D3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- İçerik Alanı -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Sol Taraf: Liste -->
                <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tablo Başlığı -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Invoice No" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Accounts / Customer" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13"/>
                                <TextBlock Grid.Column="3" Text="Grand Total" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Invoice Listesi -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Invoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectedInvoice, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <!-- Satır Hover Stili -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F9FAFB"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid Margin="15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding DocumentNumber}" Foreground="#111827" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border Background="#E0F2FE" CornerRadius="16" Width="32" Height="32" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Initials}" Foreground="#0284C7" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CustomerName}" Foreground="#374151" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DocumentTypeDisplay}" Foreground="#6B7280" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding DocumentDate, StringFormat=dd.MM.yyyy}" Foreground="#6B7280" FontSize="14" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat=N2 ₺}" Foreground="#111827" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextAlignment="Right"/>

                                                <Border Grid.Column="4" CornerRadius="12" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DEF7EC"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#03543F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                        <Setter Property="Foreground" Value="#9B1C1C"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Paging / Özet Footer -->
                        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="15" Background="#F9FAFB">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Foreground="#6B7280" FontSize="13">
                                    <Run Text="Total "/>
                                    <Run Text="{Binding TotalCount}" FontWeight="SemiBold" Foreground="#111827"/>
                                    <Run Text=" fatura listeleniyor."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sağ Taraf: Invoice Details / Dashboard Özet -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <!-- Sağ panel henüz boş or özet kartları konabilir -->
                    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Sales Summary" FontSize="16" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,15"/>
                            <TextBlock Text="Total Sales Volume" FontSize="13" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalSales}" FontSize="24" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,20"/>

                            <Border Background="#F3F4F6" Height="1" Margin="0,0,0,15"/>

                            <TextBlock Text="Last Updated By: Admin" FontSize="12" Foreground="#9CA3AF"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Ekleme / Editme Formu (Master-Detail) -->
        <Border Background="White" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Form Başlığı -->
                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,15">
                    <Grid>
                        <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>

                        <Button Command="{Binding CloseFormCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Path Data="M6 18L18 6M6 6l12 12" Stroke="#6B7280" StrokeThickness="2" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Form İçeriği -->
                <ScrollViewer Grid.Row="1" Padding="20" IsEnabled="{Binding FormModel.IsDraft}">
                    <StackPanel>
                        <!-- MASTER: Invoice Üst Informationleri -->
                        <Border Background="#F9FAFB" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Invoice Type" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding FormModel.DocumentType}" Height="36">
                                        <ComboBoxItem Content="Sales Invoice" Tag="SalesInvoice"/>
                                        <ComboBoxItem Content="Purchase Invoice" Tag="PurchaseInvoice"/>
                                        <ComboBoxItem Content="Return Invoice" Tag="ReturnInvoice"/>
                                        <ComboBoxItem Content="Exchange Invoice" Tag="ExchangeInvoice"/>
                                        <ComboBoxItem Content="Price Difference" Tag="PriceDifference"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="Invoice No" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding FormModel.DocumentNumber}" Style="{StaticResource ModernTextBox}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                    <TextBlock Text="Account (Cust/Supp)" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding Customers}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding FormModel.CustomerId}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0,0,15,0">
                                    <TextBlock Text="Invoice Date" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding FormModel.DocumentDate}" Height="36"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Warehouse" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding Warehouses}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              SelectedValue="{Binding FormModel.WarehouseId}" Height="36"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0"><TextBlock Text="Due Date" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/><DatePicker SelectedDate="{Binding FormModel.DueDate}" Height="34"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Currency" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/><ComboBox Text="{Binding FormModel.Currency}" IsEditable="True" Height="34"/></StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="Exchange Rate" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/><TextBox Text="{Binding FormModel.ExchangeRate}" Style="{StaticResource ModernTextBox}" Height="34"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="Payment Method" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,5"/><ComboBox Text="{Binding FormModel.PaymentType}" IsEditable="True" Height="34"/></StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#032D60" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="360"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="BARCODE CHECKOUT" Foreground="#9ED7FF" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="Scan or type a barcode" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="6" Height="42" Margin="0,0,18,0">
                                    <Grid>
                                        <TextBox Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="14,9"
                                                 FontFamily="Consolas" FontSize="16">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding AddByBarcodeCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Content="Add" Command="{Binding AddByBarcodeCommand}" HorizontalAlignment="Right"
                                                Background="#0176D3" Foreground="White" BorderThickness="0" Padding="18,7"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BarcodeStatus}" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="Repeated scans increase quantity automatically." Foreground="#9ED7FF" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DETAIL: Invoice lines -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Invoice lines" FontSize="16" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedNewProduct}" DisplayMemberPath="Name" Height="34" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Command="{Binding AddLineCommand}" Content="+ Add selected product"
                                    Background="#0176D3" Foreground="White" BorderThickness="0" Padding="14,7"/>
                        </Grid>

                        <Border CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Kalem Tablosu Başlığı -->
                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10" Background="#F9FAFB" CornerRadius="8,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Product Name" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="Quantity" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Unit Price" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="VAT (%)" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="Total" FontWeight="SemiBold" Foreground="#6B7280" FontSize="13" TextAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Kalemler Listesi -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding FormModel.Lines}" Margin="0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Margin="2,0,5,0">
                                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ProductCode}" Foreground="#64748B" FontSize="10"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TextAlignment="Right" Margin="0,0,5,0" Height="32"/>
                                                <TextBox Grid.Column="2" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TextAlignment="Right" Margin="0,0,5,0" Height="32"/>
                                                <TextBox Grid.Column="3" Text="{Binding VatRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" TextAlignment="Right" Margin="0,0,5,0" Height="32"/>
                                                <TextBlock Grid.Column="4" Text="{Binding LineTotalWithTax, StringFormat=N2}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#111827"/>

                                                <Button Grid.Column="5" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#EF4444" Margin="5,0,0,0">
                                                    <Path Data="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" Stroke="#EF4444" StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- New Kalem Ekle Butonu -->
                                <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="10">
                                    <TextBlock Text="Products are selected from the verified catalog; free-text product IDs are not accepted."
                                               Foreground="#64748B" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Form Alt Alanı (Totallar ve Save) -->
                <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20">
                    <Grid>
                        <!-- Totallar -->
                        <StackPanel HorizontalAlignment="Right" Margin="0,0,200,0">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:" Foreground="#6B7280" TextAlignment="Right"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormModel.SubTotal, StringFormat=N2 ₺}" Foreground="#111827" FontWeight="Medium" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VAT Total:" Foreground="#6B7280" TextAlignment="Right"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormModel.TaxAmount, StringFormat=N2 ₺}" Foreground="#111827" FontWeight="Medium" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Grand Total:" FontSize="16" FontWeight="Bold" Foreground="#111827" TextAlignment="Right"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormModel.TotalAmount, StringFormat=N2 ₺}" FontSize="16" FontWeight="Bold" Foreground="#0078D4" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- Save / Cancel -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Command="{Binding PrepareElectronicDocumentCommand}" CommandParameter="{Binding SelectedInvoice}"
                                    Content="Prepare E-Document" Background="#9050E9" Foreground="White"
                                    BorderThickness="0" Padding="16,10" Margin="0,0,10,0"/>
                            <Button Command="{Binding ReverseInvoiceCommand}" CommandParameter="{Binding SelectedInvoice}"
                                    Content="Reverse Posted" Background="#BA0517" Foreground="White"
                                    BorderThickness="0" Padding="16,10" Margin="0,0,10,0"/>

                            <!-- Sadece Draft faturalarda gösterilecek Butonlar -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding FormModel.IsDraft, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding ApproveInvoiceCommand}" Content="Approve Invoice"
                                        Background="#10B981" Foreground="White" BorderThickness="0"
                                        Padding="20,10" Margin="0,0,10,0"
                                        FontWeight="Medium" Cursor="Hand"
                                        ToolTip="Approves the invoice and creates inventory and account movements."/>

                                <Button Command="{Binding SaveInvoiceCommand}" Content="Save as Draft"
                                        Background="#0078D4" Foreground="White" BorderThickness="0"
                                        Padding="30,10" Margin="0,0,10,0" FontWeight="Medium" Cursor="Hand"/>
                            </StackPanel>

                            <Button Command="{Binding CloseFormCommand}" Content="Discard / Close"
                                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                    Foreground="#374151" Padding="20,10"
                                    FontWeight="Medium" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Yükleniyor Göstergesi -->
        <Border Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Processing..." FontSize="16" FontWeight="Medium" Foreground="#0078D4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
