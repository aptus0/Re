<UserControl x:Class="Re.Desktop.Views.Purchasing.PurchaseInvoicePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6F9">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Purchase Invoices" FontSize="27" FontWeight="Bold" Foreground="#172B4D"/><TextBlock Text="Supplier invoices, warehouse receipts and payable posting" Foreground="#5E6C84"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Approve Selected" Command="{Binding ApproveCommand}" Padding="16,9" Margin="0,0,8,0" Background="#107C10" Foreground="White" BorderThickness="0"/><Button Content="+ New Purchase Invoice" Command="{Binding NewCommand}" Padding="18,9" Background="#0176D3" Foreground="White" BorderThickness="0"/></StackPanel></Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#D8DDE6" BorderThickness="1" CornerRadius="9">
   <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="40">
    <DataGrid.Columns><DataGridTextColumn Header="DOCUMENT" Binding="{Binding DocumentNumber}" Width="130"/><DataGridTextColumn Header="SUPPLIER DOCUMENT" Binding="{Binding SupplierDocumentNumber}" Width="140"/><DataGridTextColumn Header="DATE" Binding="{Binding DocumentDate, StringFormat='dd.MM.yyyy'}" Width="100"/><DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="*"/><DataGridTextColumn Header="WAREHOUSE" Binding="{Binding WarehouseName}" Width="150"/><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat=N2}" Width="120"/><DataGridTextColumn Header="CURRENCY" Binding="{Binding Currency}" Width="75"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/></DataGrid.Columns>
   </DataGrid>
  </Border>
  <Border Grid.RowSpan="3" Background="#99000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
   <Border Width="1050" Height="700" Background="White" CornerRadius="10" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="New Purchase Invoice" FontSize="22" FontWeight="Bold"/><Button Content="X" Command="{Binding CloseEditorCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontWeight="Bold"/></Grid>
     <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Document Number"/><TextBox Text="{Binding DocumentNumber}" Height="34"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Supplier"/><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Height="34"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Warehouse"/><ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="34"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="Document Date"/><DatePicker SelectedDate="{Binding DocumentDate}" Height="34"/></StackPanel>
     </Grid>
     <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" Height="35"/><Button Grid.Column="3" Content="+ Add Product" Command="{Binding AddLineCommand}" Background="#0176D3" Foreground="White" BorderThickness="0" Padding="16,8"/></Grid>
     <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="CODE" Binding="{Binding ProductCode}" Width="90"/><DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="75"/><DataGridTextColumn Header="UNIT PRICE" Binding="{Binding UnitPrice}" Width="95"/><DataGridTextColumn Header="DISC. %" Binding="{Binding DiscountPercent}" Width="75"/><DataGridTextColumn Header="VAT %" Binding="{Binding VatRate}" Width="65"/><DataGridTextColumn Header="LOT" Binding="{Binding LotNumber}" Width="90"/><DataGridTextColumn Header="SERIAL" Binding="{Binding SerialNumber}" Width="100"/><DataGridTemplateColumn Header="" Width="65"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="#BA0517" Background="Transparent" BorderThickness="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
     </DataGrid>
     <Grid Grid.Row="4" Margin="0,16,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SubTotal, StringFormat='Subtotal ₺{0:N2}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding TaxAmount, StringFormat='VAT ₺{0:N2}'}" Margin="0,0,18,0"/><TextBlock Text="{Binding TotalAmount, StringFormat='TOTAL ₺{0:N2}'}" FontSize="17" FontWeight="Bold" Foreground="#0176D3"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Command="{Binding CloseEditorCommand}" Padding="18,9" Margin="0,0,8,0"/><Button Content="Save Draft" Command="{Binding SaveCommand}" Background="#0176D3" Foreground="White" BorderThickness="0" Padding="22,9"/></StackPanel></Grid>
    </Grid>
   </Border>
  </Border>
 </Grid>
</UserControl>
