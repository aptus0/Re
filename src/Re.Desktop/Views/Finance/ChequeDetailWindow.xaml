<Window x:Class="Re.Desktop.Views.Finance.ChequeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Re.Desktop.Converters"
        Title="Cheque / Promissory Note Details" Width="680" Height="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" UseLayoutRounding="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CurrencyConverter x:Key="CurrencyFmt"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- Custom title bar -->
            <RowDefinition Height="Auto"/> <!-- Title/Status -->
            <RowDefinition Height="Auto"/> <!-- Physical Cheque Visual -->
            <RowDefinition Height="*"/>    <!-- Timeline / Details -->
            <RowDefinition Height="54"/>   <!-- Actions / Footer -->
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#032D60" MouseDown="TitleBar_MouseDown" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎫" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Cheque / Promissory Note Details" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PORTFOLIO INQUIRY • RE ERP" Foreground="#9ED7FF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="×" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Padding="0" Width="30" Height="30" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Header Status Bar -->
        <Border Grid.Row="1" Background="#0F172A" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Document No: " Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Text="{Binding Item.Number}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" CornerRadius="12" Padding="12,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E2E8F0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="In Portfolio">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Collected">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Paid">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Endorsed (Ciro)">
                                    <Setter Property="Background" Value="#FFF7ED"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Bounced / Unpaid">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Item.StatusDisplay}" FontSize="12" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="In Portfolio">
                                        <Setter Property="Foreground" Value="#475569"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Collected">
                                        <Setter Property="Foreground" Value="#0176D3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Paid">
                                        <Setter Property="Foreground" Value="#0176D3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Endorsed (Ciro)">
                                        <Setter Property="Foreground" Value="#F97316"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Bounced / Unpaid">
                                        <Setter Property="Foreground" Value="#334155"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Physical Cheque Visual representation -->
        <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#0176D3" BorderThickness="2" CornerRadius="12" Margin="20,20,20,10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="12" ShadowDepth="4"/>
            </Border.Effect>
            
            <Grid Height="180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Bank / Branch details -->
                    <RowDefinition Height="*"/>    <!-- Pay to the order / Amount -->
                    <RowDefinition Height="Auto"/> <!-- Signature / Stamp / Bottom MICR code -->
                </Grid.RowDefinitions>
                
                <!-- Bank Info -->
                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="{Binding Item.TypeDisplay}" FontSize="11" FontWeight="Bold" Foreground="#0176D3"/>
                        <TextBlock Text="{Binding Item.BankName, TargetNullValue='PROMISSORY NOTE'}" FontSize="16" FontWeight="Bold" Foreground="#014486" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                        <TextBlock Text="DUE DATE (VADE)" FontSize="9" Foreground="#0176D3" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Item.DueDate, StringFormat='dd.MM.yyyy'}" FontSize="13" FontWeight="Bold" Foreground="#014486" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Amount and Debtor -->
                <Grid Grid.Row="1" Margin="0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pay to the order of (Cari Hesap):" FontSize="9" Foreground="#0176D3" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Item.AccountName}" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding AmountInWords}" FontSize="11" FontStyle="Italic" Foreground="#475569" Margin="0,6,0,0"/>
                    </StackPanel>
                    
                    <!-- Amount Box -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#0176D3" BorderThickness="1.5" CornerRadius="4" Padding="12,8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Item.Amount, Converter={StaticResource CurrencyFmt}}" FontSize="18" FontWeight="Bold" Foreground="#014486"/>
                    </Border>
                </Grid>

                <!-- Drawer Signature & MICR line -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- MICR code at the bottom of cheques -->
                    <TextBlock Grid.Column="0" Text="⑈ 100234⑈ 061200021⑆ 80045112⑈ 45" FontFamily="Courier New" FontSize="11" Foreground="#0176D3" VerticalAlignment="Bottom"/>
                    
                    <!-- Signature / Drawer -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" TextBlock.TextAlignment="Center">
                        <TextBlock Text="Drawer (Keşideci)" FontSize="8" Foreground="#0176D3" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Item.Drawer}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                        <Border BorderBrush="#B9E6FE" BorderThickness="0,1,0,0" Margin="0,6,0,0" Width="80">
                            <TextBlock Text="Authorized Sign" FontSize="8" Foreground="#0176D3" Margin="0,2,0,0"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Timeline & Audit Details -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="20,10,20,15" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Additional Fields -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Additional Details" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,4">
                        <TextBlock Text="Issue Date:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="{Binding Item.IssueDate, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Currency:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="{Binding Item.Currency}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="Description:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Text="{Binding Item.Description}" HorizontalAlignment="Right" FontSize="12" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Right"/>
                    </Grid>
                </StackPanel>
                
                <!-- Right: Timeline / Lifecycle -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Document Lifecycle" FontSize="14" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,12"/>
                    
                    <!-- Creation Step -->
                    <Grid Margin="0,4">
                        <Ellipse Width="8" Height="8" Fill="#0176D3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="Document Created" Margin="16,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Item.IssueDate, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
                    </Grid>
                    <Border BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0"/>

                    <!-- Portfolio Step -->
                    <Grid Margin="0,4">
                        <Ellipse Width="8" Height="8" Fill="#475569" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="Entered Portfolio" Margin="16,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Item.IssueDate, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
                    </Grid>
                    
                    <!-- Dynamic Final Step depending on status -->
                    <StackPanel Visibility="{Binding HasFinalStatus, Converter={StaticResource BoolToVis}}">
                        <Border BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Height="20" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        <Grid Margin="0,4">
                            <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#0176D3"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Bounced / Unpaid">
                                                <Setter Property="Fill" Value="#334155"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Item.StatusDisplay}" Value="Endorsed (Ciro)">
                                                <Setter Property="Fill" Value="#F97316"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Item.StatusDisplay}" Margin="16,0,0,0" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Item.DueDate, StringFormat='dd.MM.yyyy'}" HorizontalAlignment="Right" FontSize="11" Foreground="#64748B"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Footer Actions -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close Details" Click="Close_Click" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24,0" Height="34" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
