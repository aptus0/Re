<UserControl x:Class="Re.Desktop.Views.Finance.CashPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Re.Desktop.Converters"
             Background="#F1F4F8"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <conv:CurrencyConverter x:Key="CurrencyFmt"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cash Management" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Live cash accounts, balances, collections and payment movements" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastUpdated, StringFormat='Updated: {0:HH:mm}'}" VerticalAlignment="Center"
                           Foreground="#94A3B8" FontSize="11" Margin="0,0,8,0"/>
                <Button Content="↻  Refresh" Command="{Binding LoadCommand}"
                        Padding="10,0" Height="28" FontSize="12" Background="White"
                        BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569"
                        Margin="0,0,6,0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                </Button>
                <Button Content="＋  Collection / Payment" Command="{Binding NewTransactionCommand}"
                        Padding="12,0" Height="28" FontSize="12" FontWeight="Bold"
                        Background="#F97316" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="2" Columns="4">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="TOTAL TRY CASH" FontSize="9" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalCash, Converter={StaticResource CurrencyFmt}}"
                               FontSize="15" FontWeight="Bold" Foreground="#0176D3" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="TODAY'S RECEIPTS" FontSize="9" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TodayCashIn, Converter={StaticResource CurrencyFmt}}"
                               FontSize="15" FontWeight="Bold" Foreground="#166534" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="TODAY'S ISSUES" FontSize="9" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TodayCashOut, Converter={StaticResource CurrencyFmt}}"
                               FontSize="15" FontWeight="Bold" Foreground="#BA0517" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="ACTIVE CASH REGISTERS" FontSize="9" Foreground="#64748B" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CashRegisters.Count}"
                               FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tables -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cash Registers List -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="10,0">
                        <TextBlock Text="Cash Registers" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CashRegisters}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              RowHeaderWidth="0" RowHeight="28" ColumnHeaderHeight="28"
                              Background="White" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="65"/>
                            <DataGridTextColumn Header="Cash Register" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="CCY" Binding="{Binding Currency}" Width="45"/>
                            <DataGridTemplateColumn Header="Balance" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentBalance, Converter={StaticResource CurrencyFmt}}"
                                                   TextAlignment="Right" Margin="0,0,6,0"
                                                   FontWeight="SemiBold" FontSize="11" Foreground="#0176D3"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cash Movements -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="10,0">
                        <TextBlock Text="Cash Movements" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CashMovements}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              RowHeaderWidth="0" RowHeight="28" ColumnHeaderHeight="28"
                              Background="White" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" AlternatingRowBackground="#FAFCFF">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date / Time" Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cash" Binding="{Binding AccountName}" Width="110"/>
                            <DataGridTemplateColumn Header="Dir." Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="IN">
                                                            <Setter Property="Text" Value="↑"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="OUT">
                                                            <Setter Property="Text" Value="↓"/>
                                                            <Setter Property="Foreground" Value="#BA0517"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Document" Binding="{Binding ReferenceType}" Width="90"/>
                            <DataGridTemplateColumn Header="Amount" Width="100" SortMemberPath="Amount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyFmt}}"
                                                   TextAlignment="Right" Margin="0,0,6,0"
                                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Direction}" Value="IN">
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Direction}" Value="OUT">
                                                            <Setter Property="Foreground" Value="#BA0517"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Running Bal." Width="105" SortMemberPath="RunningBalance">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RunningBalance, Converter={StaticResource CurrencyFmt}}"
                                                   TextAlignment="Right" Margin="0,0,6,0"
                                                   FontWeight="Bold" FontSize="11" Foreground="#0176D3" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
