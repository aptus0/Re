<UserControl x:Class="Re.Desktop.Views.Finance.CashPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#EEF1F4">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="Kasa Yönetimi" FontSize="24" FontWeight="SemiBold" Foreground="#202328"/><TextBlock Text="Gerçek nakit hesapları, tahsilatlar, ödemeler ve bakiye hareketleri" Foreground="#667085"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding LastUpdated, StringFormat='Son güncelleme: {0}'}" VerticalAlignment="Center" Foreground="#667085" Margin="0,0,12,0"/><Button Content="Yenile" Command="{Binding LoadCommand}" Padding="14,8" Margin="0,0,7,0"/><Button Content="+ Tahsilat / Ödeme" Command="{Binding NewTransactionCommand}" Padding="14,8" Background="#B5121B" Foreground="White" BorderThickness="0"/></StackPanel></Grid>
  <UniformGrid Grid.Row="2" Columns="4"><Border Background="White" BorderBrush="#AEB8C4" BorderThickness="1" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock Text="TOPLAM TRY NAKİT" Foreground="#667085" FontSize="10"/><TextBlock Text="{Binding TotalCash, StringFormat='{}{0:N2} ₺'}" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Background="White" BorderBrush="#AEB8C4" BorderThickness="1" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock Text="BUGÜNKÜ GİRİŞ" Foreground="#667085" FontSize="10"/><TextBlock Text="{Binding TodayCashIn, StringFormat='{}{0:N2} ₺'}" FontSize="20" FontWeight="Bold" Foreground="#166534"/></StackPanel></Border><Border Background="White" BorderBrush="#AEB8C4" BorderThickness="1" Padding="14" Margin="0,0,7,0"><StackPanel><TextBlock Text="BUGÜNKÜ ÇIKIŞ" Foreground="#667085" FontSize="10"/><TextBlock Text="{Binding TodayCashOut, StringFormat='{}{0:N2} ₺'}" FontSize="20" FontWeight="Bold" Foreground="#B5121B"/></StackPanel></Border><Border Background="White" BorderBrush="#AEB8C4" BorderThickness="1" Padding="14"><StackPanel><TextBlock Text="AKTİF KASA" Foreground="#667085" FontSize="10"/><TextBlock Text="{Binding CashRegisters.Count}" FontSize="20" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#AEB8C4" BorderThickness="1"><DataGrid ItemsSource="{Binding CashRegisters}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="70"/><DataGridTextColumn Header="Kasa" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Döviz" Binding="{Binding Currency}" Width="55"/><DataGridTextColumn Header="Bakiye" Binding="{Binding CurrentBalance, StringFormat='{}{0:N2}'}" Width="100"/></DataGrid.Columns></DataGrid></Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#AEB8C4" BorderThickness="1"><DataGrid ItemsSource="{Binding CashMovements}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeaderWidth="0" AlternatingRowBackground="#F3F5F7"><DataGrid.Columns><DataGridTextColumn Header="Tarih / Saat" Binding="{Binding Date, StringFormat='dd.MM.yyyy HH:mm'}" Width="125"/><DataGridTextColumn Header="Kasa" Binding="{Binding AccountName}" Width="130"/><DataGridTextColumn Header="Yön" Binding="{Binding Direction}" Width="65"/><DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="Belge" Binding="{Binding ReferenceType}" Width="100"/><DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="100"/><DataGridTextColumn Header="Bakiye" Binding="{Binding RunningBalance, StringFormat='{}{0:N2}'}" Width="105"/></DataGrid.Columns></DataGrid></Border>
  </Grid>
 </Grid>
</UserControl>
