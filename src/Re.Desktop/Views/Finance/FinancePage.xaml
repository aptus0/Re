<UserControl x:Class="Re.Desktop.Views.Finance.FinancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Re.Desktop.Views.Finance"
      xmlns:vm="clr-namespace:Re.Desktop.ViewModels.Finance"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1024"
      Background="#F5F7FA">

    <UserControl.DataContext>
        <vm:FinanceViewModel />
    </UserControl.DataContext>

    <Grid>
        <!-- Overlay for Loading -->
        <Border Background="#80000000" Panel.ZIndex="1000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="İşlem Yapılıyor..." Foreground="White" Margin="0,10,0,0" FontSize="16" />
            </StackPanel>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Tahsilat / Ödeme" Style="{StaticResource CorporatePageTitle}" />
                <TextBlock Text="Cari hesaplarınızdan tahsilat alın veya ödeme yapın." FontSize="14" Foreground="#64748B" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Form Alanı (Windows Form/Kurumsal Tasarım) -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="30" 
                    VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="500">
                
                <StackPanel>
                    <TextBlock Text="İşlem Bilgileri" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- İşlem Tipi -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="İşlem Tipi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" />
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding TransactionType}" Margin="0,0,0,15" />

                        <!-- Cari Hesap -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cari Hesap:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" 
                                  DisplayMemberPath="Name" Margin="0,0,0,15" />

                        <!-- Ödeme Yöntemi -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ödeme Yöntemi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Margin="0,0,0,15" />

                        <!-- Kasa Seçimi (Sadece Kasa Seçiliyse) -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Kasa Seçimi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" 
                                   Visibility="{Binding IsCashSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding CashRegisters}" SelectedItem="{Binding SelectedCashRegister}" 
                                  DisplayMemberPath="DisplayName"
                                  Visibility="{Binding IsCashSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,15" />

                        <!-- Banka Seçimi (Sadece Banka Seçiliyse) -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Banka Seçimi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" 
                                   Visibility="{Binding IsBankSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding BankAccounts}" SelectedItem="{Binding SelectedBankAccount}" 
                                  DisplayMemberPath="DisplayName"
                                  Visibility="{Binding IsBankSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,15" />

                        <!-- Tutar -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tutar (TL):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15" />

                        <!-- Tarih -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="İşlem Tarihi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15" />
                        <DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding TransactionDate}" Margin="0,0,0,15" />

                        <!-- Açıklama -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Açıklama:" VerticalAlignment="Top" FontWeight="SemiBold" Foreground="#334155" Margin="0,15,0,0" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80" Margin="0,0,0,20" />
                    </Grid>

                    <Separator Margin="0,10,0,20" Background="#E2E8F0" />
                    
                    <!-- Butonlar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding SaveTransactionCommand}" 
                                Background="#C62828" BorderBrush="#8E1717" Foreground="White"
                                Width="140" Height="40" FontSize="14" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Kaydet" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
