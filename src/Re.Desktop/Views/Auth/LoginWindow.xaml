<Window x:Class="Re.Desktop.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Re ERP - Kurumsal Giriş Portalı"
        Width="840" Height="520"
        MinWidth="840" MinHeight="520"
        MaxWidth="840" MaxHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryLoginButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#0070D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005FB2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005FB2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SalesforceConnectButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#00A1E0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007BB0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007BB0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Title Bar -->
            <Grid Background="#0B132B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="24" Height="24" Background="#0070D2" CornerRadius="4" Margin="0,0,10,0">
                        <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RE ERP · Kurumsal Giriş Portalı" Foreground="#F8FAFC"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="API Başlat" Width="90" Margin="0,0,6,0"
                            Style="{StaticResource TitleButton}" Command="{Binding StartLocalApiCommand}"/>
                    <Button Content="Sunucu Ayarları" Width="105" Margin="0,0,6,0"
                            Style="{StaticResource TitleButton}" Click="SettingsButton_Click"/>
                    <Button Content="✕" Width="30" Padding="0" Style="{StaticResource TitleButton}"
                            Background="#DC2626" BorderBrush="#B91C1C" Foreground="White"
                            FontWeight="Bold" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main Body Split -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Corporate Branding Banner -->
                <Border Background="#1C2541" BorderBrush="#0070D2" BorderThickness="0,0,4,0">
                    <Grid Margin="26,26">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="110" Height="74" Background="White" CornerRadius="8"
                                    HorizontalAlignment="Left" Padding="6">
                                <Image Source="/Re.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="Re ERP Platformu" Foreground="#F8FAFC"
                                       FontSize="22" FontWeight="Bold" Margin="0,16,0,0"/>
                            <TextBlock Text="Hibrit Bulut &amp; Salesforce Yerel Kurumsal İş Çözümleri"
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"
                                       LineHeight="16" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Salesforce Org Connect Box -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Border Background="#0F172A" BorderBrush="#0070D2" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="18" Height="18" Background="#00A1E0" CornerRadius="9" Margin="0,0,6,0">
                                            <TextBlock Text="☁" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Salesforce Org Bağlantısı" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="Kurumsal Salesforce Org web hesabınız ile doğrudan tek tıkla bağlanın." Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="☁ Salesforce Org ile Bağlan" Command="{Binding ConnectSalesforceOrgCommand}" Style="{StaticResource SalesforceConnectButton}"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="MSSQL Zaman Çizelgeli Muhasebe &amp; Denetim" Foreground="#CBD5E1" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Salesforce Yerel 2GP (reerp) Çift Yönlü Senkronizasyon" Foreground="#CBD5E1" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="RE KURUMSAL ÇÖZÜMLER" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="v1.1.0 · Kurumsal Sürüm" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Form Area -->
                <Grid Grid.Column="1" Background="#FFFFFF" Margin="34,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Kurumsal Oturum Aç" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Sistem yetki bilgilerinizi girin veya Salesforce SSO kullanın."
                                   FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="👤 " Foreground="#0070D2" FontSize="11"/>
                                <TextBlock Text="Kullanıcı Adı" Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="🔒 " Foreground="#0070D2" FontSize="11"/>
                                <TextBlock Text="Giriş Şifresi" Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                         Style="{StaticResource LoginPasswordBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="🏢 " Foreground="#0070D2" FontSize="11"/>
                                <TextBlock Text="Şube Kodu" Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                            <TextBox Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="🏬 " Foreground="#0070D2" FontSize="11"/>
                                <TextBlock Text="Depo / Mağaza Kodu" Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                            <TextBox Text="{Binding StoreCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding ApiStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ApiStatusMessage}" Foreground="{Binding ApiStatusColor}"
                                           FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Şifremi unuttum?" HorizontalAlignment="Right" Foreground="#0070D2"
                                       FontSize="10.5" FontWeight="SemiBold" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ForgotPasswordCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>

                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                Padding="10,8" Margin="0,10,0,0" CornerRadius="4"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " Foreground="#DC2626" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="10.5"
                                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="5">
                        <Button Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}"
                                IsEnabled="{Binding CanLogin}" IsDefault="True"
                                Style="{StaticResource PrimaryLoginButton}"/>
                        <TextBlock Text="Oturum açarak kurumsal güvenlik ve veri gizliliği politikasını kabul etmiş olursunuz."
                                   Foreground="#94A3B8" FontSize="9" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
