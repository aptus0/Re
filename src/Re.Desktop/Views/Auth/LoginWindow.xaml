<Window x:Class="Re.Desktop.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Re ERP - Corporate Sign In"
        Width="820" Height="500"
        MinWidth="820" MinHeight="500"
        MaxWidth="820" MaxHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F172A"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryLoginButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#0176D3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#015091"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#015091"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SalesforceConnectButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#00A1E0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#007BB0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#007BB0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#334155" BorderThickness="1" Background="#0F172A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Title Bar -->
            <Grid Background="#0B132B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Border Width="24" Height="24" Background="#0176D3" CornerRadius="4" Margin="0,0,10,0">
                        <TextBlock Text="R" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RE ERP · Corporate Enterprise Portal" Foreground="#F8FAFC"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="Start Server" Width="100" Margin="0,0,6,0"
                            Style="{StaticResource TitleButton}" Command="{Binding StartLocalApiCommand}"/>
                    <Button Content="Server Settings" Width="110" Margin="0,0,6,0"
                            Style="{StaticResource TitleButton}" Click="SettingsButton_Click"/>
                    <Button Content="✕" Width="30" Padding="0" Style="{StaticResource TitleButton}"
                            Background="#DC2626" BorderBrush="#B91C1C" Foreground="White"
                            FontWeight="Bold" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Main Body Split -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Corporate Branding Banner -->
                <Border Background="#1C2541" BorderBrush="#0176D3" BorderThickness="0,0,4,0">
                    <Grid Margin="28,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border Width="110" Height="76" Background="White" CornerRadius="6"
                                    HorizontalAlignment="Left" Padding="6">
                                <Image Source="/Re.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="Re ERP Platform" Foreground="#F8FAFC"
                                       FontSize="22" FontWeight="Bold" Margin="0,18,0,0"/>
                            <TextBlock Text="Hybrid Cloud &amp; Salesforce Native Enterprise Suite"
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"
                                       LineHeight="16" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Salesforce Org Connect Box -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Border Background="#0F172A" BorderBrush="#0176D3" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="18" Height="18" Background="#00A1E0" CornerRadius="9" Margin="0,0,6,0">
                                            <TextBlock Text="☁" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Salesforce Org Connect" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Text="Sign in directly using your corporate Salesforce Org web credentials." Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="Connect with Salesforce Org" Command="{Binding ConnectSalesforceOrgCommand}" Style="{StaticResource SalesforceConnectButton}"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="MSSQL Temporal Ledgers &amp; Auditing" Foreground="#CBD5E1" FontSize="11"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Salesforce Native 2GP (reerp) Sync" Foreground="#CBD5E1" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="RE BUSINESS SOLUTIONS" Foreground="#64748B" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="v1.1.0 · Enterprise Edition" Foreground="#94A3B8" FontSize="9" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Form Area -->
                <Grid Grid.Column="1" Background="#FFFFFF" Margin="36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Corporate Sign In" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Enter your authorized credentials or use Salesforce SSO."
                                   FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"
                                         Style="{StaticResource LoginPasswordBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Branch Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Store / Warehouse Code" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StoreCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding ApiStatusColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ApiStatusMessage}" Foreground="{Binding ApiStatusColor}"
                                           FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Forgot password?" HorizontalAlignment="Right" Foreground="#0176D3"
                                       FontSize="10" FontWeight="SemiBold" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ForgotPasswordCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </Grid>

                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                Padding="10,7" Margin="0,10,0,0" CornerRadius="4"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="10"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="5">
                        <Button Content="{Binding LoginButtonText}" Command="{Binding LoginCommand}"
                                IsEnabled="{Binding CanLogin}" IsDefault="True"
                                Style="{StaticResource PrimaryLoginButton}"/>
                        <TextBlock Text="By signing in, you accept corporate security and compliance policies."
                                   Foreground="#94A3B8" FontSize="9" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
