<Window x:Class="Re.Desktop.Views.Accounts.AccountDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account 360 Details" Width="1050" Height="720" MinWidth="1050" MinHeight="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" UseLayoutRounding="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        
        <Style x:Key="CorporateHeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CorporateHeaderValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#54698D"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="#F4F6F9"/>
            <Setter Property="BorderBrush" Value="#D8DDE6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0070D2"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                    <Setter Property="BorderBrush" Value="#D8DDE6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/> <!-- Custom title bar -->
            <RowDefinition Height="Auto"/> <!-- Quick Info -->
            <RowDefinition Height="*"/>    <!-- Content Tabs -->
            <RowDefinition Height="54"/>   <!-- Actions Footer -->
        </Grid.RowDefinitions>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="4" Background="#80FFFFFF" Panel.ZIndex="100" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="8" Foreground="#0070D2"/>
                <TextBlock Text="Loading Account Activity..." Foreground="#475569" FontWeight="Bold" Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 0. Drag Header -->
        <Border Grid.Row="0" Background="#032D60" MouseDown="TitleBar_MouseDown" Padding="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="Account 360 Degree View" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="FINANCIAL ANALYTICS • RE ERP" Foreground="#9ED7FF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="×" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Padding="0" Width="30" Height="30" Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Quick Info Section -->
        <Border Grid.Row="1" Background="#0C2340" Padding="24,16" BorderBrush="#021B3D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#0070D2" CornerRadius="4" Padding="8,2" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Account.AccountType}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding Account.Code}" Foreground="#9ED7FF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Account.Name}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Account.Representative, StringFormat='Rep: {0}', TargetNullValue='No Representative Assigned'}" Foreground="#94A3B8" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Financial Balance Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1A365D" CornerRadius="8" Padding="16,8" Margin="0,0,10,0" MinWidth="130">
                        <StackPanel>
                            <TextBlock Text="RECEIVABLES" Style="{StaticResource CorporateHeaderLabel}"/>
                            <TextBlock Text="{Binding ReceivableText}" Style="{StaticResource CorporateHeaderValue}" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A365D" CornerRadius="8" Padding="16,8" Margin="0,0,10,0" MinWidth="130">
                        <StackPanel>
                            <TextBlock Text="PAYABLES" Style="{StaticResource CorporateHeaderLabel}"/>
                            <TextBlock Text="{Binding PayableText}" Style="{StaticResource CorporateHeaderValue}" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1A365D" CornerRadius="8" Padding="16,8" MinWidth="130">
                        <StackPanel>
                            <TextBlock Text="NET BALANCE" Style="{StaticResource CorporateHeaderLabel}"/>
                            <TextBlock Text="{Binding NetBalanceText}" Style="{StaticResource CorporateHeaderValue}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content Tabs -->
        <TabControl Grid.Row="2" Background="White" BorderThickness="0" Margin="16,16,16,0">
            
            <!-- Tab 1: Ledger Activities -->
            <TabItem Header="📋 General Ledger">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="All Activities &amp; Ledger Entries" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="32" Width="280">
                            <Grid>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="0"/>
                                <TextBlock Text="Search ledger..." Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center"
                                           Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Activities}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="36" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="45"/>
                            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="90"/>
                            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Day Name" Binding="{Binding DayName}" Width="90"/>
                            <DataGridTextColumn Header="Full Date" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="100"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn Header="Doc Reference" Binding="{Binding ReferenceType}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Amount (TL)" Binding="{Binding Amount, StringFormat='N2'}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Balance (TL)" Binding="{Binding RunningBalance, StringFormat='N2'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Collections History (Tahsilat) -->
            <TabItem Header="💰 Collections (Tahsilat Geçmişi)">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Received Payments &amp; Collections" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Collections}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="36" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="45"/>
                            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="90"/>
                            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Day Name" Binding="{Binding DayName}" Width="95"/>
                            <DataGridTextColumn Header="Full Date" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="105"/>
                            <DataGridTextColumn Header="Reference Doc" Binding="{Binding ReferenceType}" Width="130"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Collected Amount" Binding="{Binding Amount, StringFormat='N2'}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Payments History (Ödeme) -->
            <TabItem Header="💸 Payments (Ödeme Geçmişi)">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Disbursements &amp; Paid Operations" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Payments}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="36" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Day" Binding="{Binding Day}" Width="45"/>
                            <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="90"/>
                            <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Day Name" Binding="{Binding DayName}" Width="95"/>
                            <DataGridTextColumn Header="Full Date" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="105"/>
                            <DataGridTextColumn Header="Reference Doc" Binding="{Binding ReferenceType}" Width="130"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Paid Amount" Binding="{Binding Amount, StringFormat='N2'}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 4: Product Analytics -->
            <TabItem Header="📦 Product Analytics">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Frequently Purchased / Sold Products" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0" RowHeight="36" HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="150"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat='N2'}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Net Amount (TL)" Binding="{Binding NetAmount, StringFormat='N2'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Foreground" Value="#0070D2"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 5: Risk Aging -->
            <TabItem Header="⚠️ Overdue aging &amp; Risk">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Overdue Aging Buckets" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="#0F172A"/>
                        
                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <TextBlock Text="Total Overdue Amount" FontWeight="SemiBold" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding Summary.Aging.TotalOverdue, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#991B1B"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,6">
                            <TextBlock Text="Current (Not Due)"/>
                            <TextBlock Text="{Binding Summary.Aging.Current, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <Grid Margin="0,6">
                            <TextBlock Text="1 - 30 Days Overdue"/>
                            <TextBlock Text="{Binding Summary.Aging.Days1To30, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <Grid Margin="0,6">
                            <TextBlock Text="31 - 60 Days Overdue"/>
                            <TextBlock Text="{Binding Summary.Aging.Days31To60, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <Grid Margin="0,6">
                            <TextBlock Text="61 - 90 Days Overdue"/>
                            <TextBlock Text="{Binding Summary.Aging.Days61To90, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        <Grid Margin="0,6">
                            <TextBlock Text="Over 90 Days Overdue" Foreground="#EF4444"/>
                            <TextBlock Text="{Binding Summary.Aging.Over90, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#EF4444"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Risk Metrics &amp; Credit Limits" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" Foreground="#0F172A"/>
                        
                        <Grid Margin="0,6">
                            <TextBlock Text="Customer Segment:"/>
                            <TextBlock Text="{Binding Summary.CustomerSegment}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#0070D2"/>
                        </Grid>
                        <Separator Margin="0,6"/>
                        
                        <Grid Margin="0,6">
                            <TextBlock Text="Credit Limit:"/>
                            <TextBlock Text="{Binding Account.CreditLimit, StringFormat='{}{0:N2} TL'}" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>
                        <Separator Margin="0,6"/>

                        <Grid Margin="0,6">
                            <TextBlock Text="Maximum Days Overdue:"/>
                            <TextBlock Text="{Binding Summary.Aging.MaximumDaysOverdue, StringFormat='{}{0} Days'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Separator Margin="0,6"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="AI-Powered Credit Risk Rating" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary.RiskLevel}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Summary.RiskLevel}" Value="High">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Summary.RiskLevel}" Value="Critical">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="50" Height="50" CornerRadius="25" Background="#E2E8F0">
                                    <TextBlock Text="{Binding Summary.RiskScore}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Actions Footer -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock Text="Right-click in general ledger for advanced operations. All balance sheets are real-time." VerticalAlignment="Center" Foreground="#64748B" FontSize="11.5" FontStyle="Italic"/>
                <Button Content="Close Details" Click="Close_Click" HorizontalAlignment="Right" Width="120" Height="34" Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
