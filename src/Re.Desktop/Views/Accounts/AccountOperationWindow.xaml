<Window x:Class="Re.Desktop.Views.Accounts.AccountOperationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Account Operation" Width="650" Height="620" WindowStartupLocation="CenterOwner"
 ResizeMode="NoResize" Background="#F4F6F9">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
  <Border Background="#032D60" Padding="22,15"><Grid><StackPanel><TextBlock Text="ACCOUNT OPERATION" Foreground="#9ED7FF" FontWeight="Bold" FontSize="11"/><TextBlock Text="{Binding Account.Name}" Foreground="White" FontWeight="Bold" FontSize="20"/><TextBlock Text="{Binding Account.Code}" Foreground="#C9E6FA" FontSize="11"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="CURRENT BALANCE" Foreground="#9ED7FF" FontSize="10"/><TextBlock Text="{Binding Account.Balance, StringFormat='₺{0:N2}'}" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#D8DDE6" BorderThickness="1" CornerRadius="8" Padding="22" Margin="20">
   <StackPanel>
    <TextBlock Text="Operation Type *" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding OperationTypes}" SelectedItem="{Binding SelectedOperationType}" Height="35" Margin="0,5,0,8"/>
    <Border Background="#F4F9FF" BorderBrush="#B3D7F2" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12"><TextBlock Text="{Binding EffectText}" Foreground="#014486"/></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Amount *" FontWeight="SemiBold"/><TextBox Text="{Binding Amount}" Height="35" Margin="0,5,0,12"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Currency / Exchange Rate"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" Height="35"/><TextBox Grid.Column="2" Text="{Binding ExchangeRate}" Height="35"/></Grid></StackPanel>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Movement Date"/><DatePicker SelectedDate="{Binding MovementDate}" Height="35" Margin="0,5,0,12"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Due Date"/><DatePicker SelectedDate="{Binding DueDate}" Height="35" Margin="0,5,0,12"/></StackPanel>
    </Grid>
    <TextBlock Text="Reference Number"/><TextBox Text="{Binding ReferenceNumber}" Height="35" Margin="0,5,0,12"/>
    <TextBlock Text="Description *" FontWeight="SemiBold"/><TextBox Text="{Binding Description}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#D8DDE6" BorderThickness="0,1,0,0" Padding="20,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click" Padding="20,9" Margin="0,0,8,0"/><Button Content="Post Operation" Command="{Binding SaveCommand}" Background="#0176D3" Foreground="White" BorderThickness="0" Padding="22,9"/></StackPanel></Border>
 </Grid>
</Window>
