<UserControl x:Class="Re.Desktop.Views.Accounts.AccountListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Re.Desktop.ViewModels.Accounts"
      Background="#F5F7FA">

    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AEB8C6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#172033"/>
            <Setter Property="SelectionBrush" Value="#B9D7F5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AEB8C6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F4F6F8"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="BorderBrush" Value="#AEB8C6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D7DCE3"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D7DCE3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Ana İçerik -->
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Başlık & Butonlar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cari Hesaplar" FontSize="28" FontWeight="Bold" Foreground="#1E293B" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='Toplam {0} kayıt listeleniyor'}"
                               FontSize="14" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="170" Height="34" Margin="0,0,10,0"
                              ItemsSource="{Binding AccountGroups}" SelectedItem="{Binding SelectedAccountGroup}"/>
                    <Border Background="White" CornerRadius="8" Padding="12,8" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🔍" FontSize="16" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="200" Background="Transparent" BorderThickness="0" Margin="24,0,0,0"
                                     VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock Text="Cari ara..." Foreground="#94A3B8" FontSize="14" IsHitTestVisible="False" Margin="24,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsSearchEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                    <Button Content="+ Yeni Cari Hesap" Command="{Binding NewAccountCommand}"
                            Background="#C62828" Foreground="White" BorderThickness="0" Padding="14,8"
                            FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Özet Kartları -->
            <UniformGrid Grid.Row="2" Columns="5" Rows="1">
                <Border Background="White" CornerRadius="3" Padding="12" Margin="0,0,6,0" BorderBrush="#C8C8C8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOPLAM CARİ" FontSize="10" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="#171717" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="3" Padding="12" Margin="0,0,6,0" BorderBrush="#C8C8C8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOPLAM ALACAK" FontSize="10" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalPayables}" FontSize="20" FontWeight="Bold" Foreground="#171717" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="3" Padding="12" Margin="0,0,6,0" BorderBrush="#C8C8C8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOPLAM BORÇ" FontSize="10" Foreground="#666" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalReceivables}" FontSize="20" FontWeight="Bold" Foreground="#C62828" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="3" Padding="12" Margin="0,0,6,0" BorderBrush="#C8C8C8" BorderThickness="1">
                    <StackPanel><TextBlock Text="MÜŞTERİLER" FontSize="10" Foreground="#666" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerCount}" FontSize="20" FontWeight="Bold" Foreground="#171717" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="3" Padding="12" BorderBrush="#C8C8C8" BorderThickness="1">
                    <StackPanel><TextBlock Text="TEDARİKÇİLER" FontSize="10" Foreground="#666" FontWeight="SemiBold"/><TextBlock Text="{Binding SupplierCount}" FontSize="20" FontWeight="Bold" Foreground="#171717" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <!-- Master-Detail Alanı -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Sol Taraf: Liste -->
                <Border Grid.Column="0" Background="White" CornerRadius="3" BorderBrush="#B8B8B8" BorderThickness="1" ClipToBounds="True">
                    <Border.Effect><DropShadowEffect Color="#E2E8F0" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
                    
                    <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              AutoGenerateColumns="False" CanUserAddRows="False" Background="Transparent"
                              BorderThickness="0" RowHeight="42" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#DDDDDD" VerticalGridLinesBrush="#DDDDDD"
                              AlternationCount="2" AlternatingRowBackground="#F5F5F5" Margin="0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#202124"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="9,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FDECEC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F4CACA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="15,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Cari" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="40" Height="40" CornerRadius="20" Background="#E0E7FF" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding NameInitials}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#C62828"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding Code, StringFormat='Kod: {0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Header="Bakiye" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Balance, StringFormat='N2'}" FontWeight="Bold" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BalanceType}" Value="Borçlu">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BalanceType}" Value="Alacaklı">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BalanceType}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Durum" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Sağ Taraf: Profil / Detay Paneli (Flyout) -->
                <Border Grid.Column="1" Width="400" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="20,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPanelOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect><DropShadowEffect Color="#E2E8F0" BlurRadius="15" ShadowDepth="-4" Opacity="0.5"/></Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" HorizontalAlignment="Right" Margin="16" Content="X" 
                                Command="{Binding ClosePanelCommand}" 
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontWeight="Bold" FontSize="16" Cursor="Hand"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                            <StackPanel Margin="24,0,24,24" DataContext="{Binding SelectedAccount}">
                                
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <Border Width="80" Height="80" CornerRadius="40" Background="#C62828" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding NameInitials}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="28" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" Foreground="#1E293B" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Type}" FontSize="14" Foreground="#64748B" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>

                                <UniformGrid Columns="2" Margin="0,0,0,24">
                                    <Button Content="Düzenle" Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="0,10" Margin="0,0,6,0" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button Content="Ekstre Al" Background="#F1F1F1" Foreground="#C62828" BorderThickness="1" BorderBrush="#C8C8C8" Padding="0,10" Margin="6,0,0,0" FontWeight="SemiBold" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </UniformGrid>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Güncel Bakiye:" FontSize="14" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding Balance, StringFormat='N2'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Risk Limiti:" FontSize="14" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding RiskLimit, StringFormat='N2'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding RiskPercentage}" Height="6" Background="#E2E8F0" Foreground="#EF4444" BorderThickness="0">
                                            <ProgressBar.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="3"/>
                                                </Style>
                                            </ProgressBar.Resources>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding RiskPercentage, StringFormat='Risk Kullanımı: %{0:F0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="İletişim Bilgileri" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>
                                <StackPanel Margin="0,0,0,24">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="📞" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Phone}" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="✉" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Email}" Foreground="#C62828" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="📍" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Address}" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="🏢" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TaxNumber, StringFormat='Vergi No: {0}'}" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Son İşlemler" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Transactions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                                        <TextBlock Text="{Binding Date, StringFormat='dd MMM yyyy'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='N2'}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Borç">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Alacak">
                                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FORM OVERLAY (EKLE / DÜZENLE MODAL) -->
        <Border Background="#99000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Border Width="900" Height="650" Background="#F2F3F5" BorderBrush="#7D8998" BorderThickness="1"
                        CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="40" Opacity="0.2" ShadowDepth="10"/>
                    </Border.Effect>
                    <Grid DataContext="{Binding FormModel}">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#263244"/>
                            </Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#9AA6B5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="7,6"/>
                                <Setter Property="CaretBrush" Value="#111827"/>
                            </Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Foreground" Value="#111827"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#9AA6B5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="7,6"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık & Kapat -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <TextBlock Text="{Binding DataContext.FormTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                            <Button Content="X" Command="{Binding DataContext.CloseFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>

                        <TabControl Grid.Row="1" Margin="0,0,0,16" Background="Transparent" BorderThickness="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="Foreground" Value="#202124"/>
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="Border" Padding="11,8" Background="{TemplateBinding Background}" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,3,0" Cursor="Hand">
                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      ContentSource="Header" RecognizesAccessKey="True"
                                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#C62828"/>
                                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="False">
                                                        <Setter TargetName="Border" Property="Background" Value="#F0F0F0"/>
                                                        <Setter Property="Foreground" Value="#202124"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#FDECEC"/>
                                                        <Setter Property="Foreground" Value="#A61F1F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>

                            <!-- 1. Genel Bilgiler -->
                            <TabItem Header="Genel Bilgiler">
                                <StackPanel Margin="16,24,16,16">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Cari Kod" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding Code}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Hesap Türü" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <ComboBox Text="{Binding Type}" IsEditable="True" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Firma / Kişi Adı *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding Name}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Vergi No / TCKN" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding TaxNumber}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Vergi Dairesi" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding TaxOffice}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- 2. İletişim Bilgileri -->
                            <TabItem Header="İletişim">
                                <StackPanel Margin="16,24,16,16">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Telefon" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding Phone}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cep Telefonu" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding MobilePhone}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="E-posta" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding Email}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Web Sitesi" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding Website}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- 3. Adresler -->
                            <TabItem Header="Adresler">
                                <StackPanel Margin="16,24,16,16">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Açık Adres" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding Address}" TextWrapping="Wrap" Height="60" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="İl" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding City}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="İlçe" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding District}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- 4. Finansal Bilgiler -->
                            <TabItem Header="Finans">
                                <StackPanel Margin="16,24,16,16">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Risk Limiti" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding RiskLimit, StringFormat='N2'}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Başlangıç Bakiyesi" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding InitialBalance, StringFormat='N2'}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Vade Süresi (Gün)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox Text="{Binding PaymentTermDays}" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Para Birimi" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <ComboBox Text="{Binding Currency}" IsEditable="True" Padding="10,8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- Diğer Sekmeler -->
                            <TabItem Header="Bakiye / Risk"><StackPanel Margin="16,24,16,16"><TextBlock Text="Bakiye Yaşlandırma Raporları..." FontStyle="Italic" Foreground="#64748B"/></StackPanel></TabItem>
                            <TabItem Header="Cari Hareketler"><StackPanel Margin="16,24,16,16"><TextBlock Text="Geçmiş İşlemler Dökümü..." FontStyle="Italic" Foreground="#64748B"/></StackPanel></TabItem>
                            <TabItem Header="Alış / Satış"><StackPanel Margin="16,24,16,16"><TextBlock Text="Satış ve Alış İstatistikleri..." FontStyle="Italic" Foreground="#64748B"/></StackPanel></TabItem>
                            <TabItem Header="CRM"><StackPanel Margin="16,24,16,16"><TextBlock Text="Müşteri Notları ve Görüşmeler..." FontStyle="Italic" Foreground="#64748B"/></StackPanel></TabItem>
                            <TabItem Header="Belgeler"><StackPanel Margin="16,24,16,16"><TextBlock Text="Cari Sözleşmeleri ve Belgeler..." FontStyle="Italic" Foreground="#64748B"/></StackPanel></TabItem>
                            <TabItem Header="E-Dönüşüm"><StackPanel Margin="16,24,16,16"><TextBlock Text="E-Fatura Entegrasyon Ayarları..." FontStyle="Italic" Foreground="#64748B"/></StackPanel></TabItem>

                        </TabControl>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="İptal" Command="{Binding DataContext.CloseFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="0,12" FontSize="15" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                            <Button Grid.Column="2" Content="Kaydet" Command="{Binding DataContext.SaveAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="#C62828" Foreground="White" BorderThickness="0" Padding="0,10" FontSize="13" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
