<Window x:Class="Re.Desktop.Views.Common.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True">
    
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.12" Color="#000000"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Content Area -->
                <RowDefinition Height="Auto"/> <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Decorative left color stripe -->
            <Border Width="6" HorizontalAlignment="Left" Background="{Binding AccentBrush}" CornerRadius="12,0,0,12" Grid.RowSpan="2"/>

            <!-- Main Content Area -->
            <Grid Grid.Row="0" Margin="24,24,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Status Icon Circle -->
                <Border Width="40" Height="40" Background="{Binding IconBackground}" CornerRadius="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Symbol}" Foreground="{Binding AccentBrush}" FontSize="18"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>

                <!-- Title & Message Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Title}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Message}" Foreground="#475569" FontSize="13" LineHeight="20" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- Action Footer -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <Grid Margin="20,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="{Binding CancelText}" Width="85" Height="34"
                                Background="White" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                                Margin="0,0,8,0" FontWeight="SemiBold" Cursor="Hand" Click="Cancel_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="{Binding AcceptText}" Width="95" Height="34"
                                Background="{Binding AccentBrush}" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" Cursor="Hand" Click="Accept_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
