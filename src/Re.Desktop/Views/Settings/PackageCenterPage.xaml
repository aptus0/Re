<UserControl x:Class="Re.Desktop.Views.Settings.PackageCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Grid Grid.Row="0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="#0070D2" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Paket &amp; Modül Merkezi" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Çekirdek modüller korunur. İhtiyacınıza göre ek işlevsel yetenekleri ve entegrasyonları tek tıkla yükleyin."
                                   Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Top Action Badge -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Command="{Binding CheckUpdatesCommand}" Background="#E2E8F0" Foreground="#334155"
                        BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" Cursor="Hand" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Güncellemeleri Kontrol Et" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="16" Padding="14,6">
                    <TextBlock Text="YEREL PAKET KATALOĞU v1.1.0" Foreground="#0369A1" FontWeight="Bold" FontSize="11"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Package List Container -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Packages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.03" ShadowDepth="2" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- Package Large Emoji Icon -->
                                <Border Width="48" Height="48" CornerRadius="10" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                                    <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title, Category & Description -->
                                <StackPanel Grid.Column="1" Margin="10,0,20,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Version, StringFormat='  v{0}'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="#475569" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>

                                <!-- Status Badge & Toggle Action Button -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Action Button -->
                                    <Button Content="{Binding ActionText}"
                                            Command="{Binding DataContext.TogglePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="18,8" MinWidth="110" Height="36" FontWeight="Bold" FontSize="12" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#0070D2"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#005FB2"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCore}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Background" Value="#E2E8F0"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
