<UserControl x:Class="Re.Desktop.Views.Settings.PackageCenterPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F4F6F9">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel>
    <TextBlock Text="Package Center" FontSize="26" FontWeight="Bold" Foreground="#172B4D"/>
    <TextBlock Text="Core business modules are protected. Add optional capabilities whenever your operation needs them." Foreground="#5E6C84" Margin="0,6,0,18"/>
   </StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E8F3FF" CornerRadius="16" Padding="14,7">
    <TextBlock Text="LOCAL PACKAGE CATALOG" Foreground="#0176D3" FontWeight="Bold" FontSize="11"/>
   </Border>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <ItemsControl ItemsSource="{Binding Packages}">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="White" BorderBrush="#D8DDE6" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="8" Background="#E8F3FF">
         <TextBlock Text="PKG" Foreground="#0176D3" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1">
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#172B4D"/>
          <TextBlock Text="{Binding Version, StringFormat='  v{0}'}" Foreground="#8993A4" VerticalAlignment="Center"/>
         </StackPanel>
         <TextBlock Text="{Binding Description}" Foreground="#5E6C84" Margin="0,5,20,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
         <Border Background="#E3FCEF" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" Margin="0,0,0,8">
          <TextBlock Text="{Binding StatusText}" Foreground="#006644" FontWeight="SemiBold"/>
         </Border>
         <Button Content="{Binding ActionText}" Command="{Binding DataContext.TogglePackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 CommandParameter="{Binding}" Padding="16,7" MinWidth="110"/>
        </StackPanel>
       </Grid>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Grid>
</UserControl>
