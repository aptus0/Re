<UserControl x:Class="Re.Desktop.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F3F5">
    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#0176D3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0176D3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="SectionBox" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#0176D3"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryCommandButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#EA580C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EA580C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C2410C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid>
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings.Title}" FontSize="26" FontWeight="Bold" Foreground="#16325C"/>
                <TextBlock Text="{DynamicResource Settings.Subtitle}"
                           FontSize="13" Foreground="#54698D" Margin="0,4,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#F4F6F9"
                    BorderBrush="#D8DDE6" BorderThickness="1" Padding="14,7" CornerRadius="4">
                <TextBlock x:Name="StatusText" Text="{DynamicResource Settings.NoChanges}" Foreground="#54698D" FontSize="12"/>
            </Border>
        </Grid>

        <!-- Settings Tab Control -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D8DDE6" BorderThickness="1">
            <TabControl Background="White" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#54698D"/>
                        <Setter Property="Background" Value="#F4F6F9"/>
                        <Setter Property="BorderBrush" Value="#D8DDE6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="20,11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="#0070D2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!-- Company & Branch -->
                <TabItem Header="{DynamicResource Settings.Tab.Company}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <GroupBox Header="{DynamicResource Settings.CompanyIdentity}" Style="{StaticResource SectionBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.CompanyName}" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="Re ERP A.Ş."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.TaxNumber}" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="1234567890"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="{DynamicResource Settings.TaxOffice}" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="Büyük Mükellefler V.D."/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.DefaultCurrency}" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="0"><ComboBoxItem Content="TRY - Türk Lirası (₺)"/><ComboBoxItem Content="USD ($)"/><ComboBoxItem Content="EUR (€)"/></ComboBox>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource Settings.LanguageRegion}" Style="{StaticResource SectionBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox x:Name="InterfaceLanguage" Padding="10,6"
                                                  SelectionChanged="InterfaceLanguage_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Settings.Turkish}" Tag="tr-TR"/>
                                            <ComboBoxItem Content="{DynamicResource Settings.English}" Tag="en-US"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.DateFormat}" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="0" Padding="10,6">
                                            <ComboBoxItem Content="tr-TR (GG.AA.YYYY)"/>
                                            <ComboBoxItem Content="en-US (MM/DD/YYYY)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource Settings.BranchOps}" Style="{StaticResource SectionBox}">
                                <StackPanel>
                                    <CheckBox Content="{DynamicResource Settings.RequireBranch}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Settings.RestrictUserBranch}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Settings.BranchDocSeries}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Inventory & Warehouse -->
                <TabItem Header="{DynamicResource Settings.Tab.Inventory}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <GroupBox Header="{DynamicResource Settings.StockRules}" Style="{StaticResource SectionBox}">
                                <StackPanel>
                                    <CheckBox Content="{DynamicResource Settings.AllowNegativeStock}"/>
                                    <CheckBox Content="{DynamicResource Settings.ReserveStockOnOrder}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Settings.CostApproval}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Settings.StockAdjustmentApproval}" IsChecked="True"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource Settings.StockDefaults}" Style="{StaticResource SectionBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.PrimaryWarehouse}" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="0"><ComboBoxItem Content="Merkez Depo"/></ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.ValuationMethod}" Style="{StaticResource LabelStyle}"/>
                                        <ComboBox SelectedIndex="0"><ComboBoxItem Content="Ağırlıklı Ortalama (Moving Average)"/><ComboBoxItem Content="FIFO"/></ComboBox>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Documents & Finance -->
                <TabItem Header="{DynamicResource Settings.Tab.Documents}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <GroupBox Header="{DynamicResource Settings.DocNumbering}" Style="{StaticResource SectionBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.SalesInvoicePrefix}" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="SF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Settings.StockMovePrefix}" Style="{StaticResource LabelStyle}"/>
                                        <TextBox Text="SM"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource Settings.FinanceRules}" Style="{StaticResource SectionBox}">
                                <StackPanel>
                                    <CheckBox Content="{DynamicResource Settings.RiskApproval}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Settings.OverdueWarning}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Settings.AutoReversal}" IsChecked="True"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Security -->
                <TabItem Header="{DynamicResource Settings.Tab.Security}">
                    <StackPanel Margin="24">
                        <GroupBox Header="{DynamicResource Settings.SessionPassword}" Style="{StaticResource SectionBox}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.SessionTimeout}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Settings.MinPasswordLength}" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="8"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="{DynamicResource Settings.AuditLogging}" Style="{StaticResource SectionBox}">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource Settings.AuditLogCritical}" IsChecked="True"/>
                                <CheckBox Content="{DynamicResource Settings.LogFailedLogins}" IsChecked="True"/>
                                <CheckBox Content="{DynamicResource Settings.LockoutAfterAttempts}" IsChecked="True"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <!-- Barcode & Printer -->
                <TabItem Header="{DynamicResource Settings.Tab.Barcode}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <GroupBox Header="{DynamicResource Settings.BarcodeSetup}" Style="{StaticResource SectionBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel><TextBlock Text="{DynamicResource Settings.PrinterName}" Style="{StaticResource LabelStyle}"/><TextBox x:Name="BarcodePrinterName" Text="Godex EZ120 / TSC 244"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Settings.PrinterLang}" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="PrinterLanguage" SelectedIndex="0"><ComboBoxItem Content="Windows / GDI"/><ComboBoxItem Content="ZPL"/><ComboBoxItem Content="TSPL"/><ComboBoxItem Content="EPL"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource Settings.ResolutionDpi}" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="PrinterDpi" SelectedIndex="0"><ComboBoxItem Content="203"/><ComboBoxItem Content="300"/><ComboBoxItem Content="600"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Varsayılan Kopya" Style="{StaticResource LabelStyle}"/><TextBox x:Name="DefaultBarcodeCopies" Text="1"/></StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Etiket Şablonu &amp; Yazdırma Kuralları" Style="{StaticResource SectionBox}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Etiket Boyutu" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="LabelSize" SelectedIndex="0"><ComboBoxItem Content="40 x 30 mm"/><ComboBoxItem Content="50 x 30 mm"/><ComboBoxItem Content="60 x 40 mm"/><ComboBoxItem Content="100 x 50 mm"/></ComboBox></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Barkod Standardı" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="BarcodeStandard" SelectedIndex="0"><ComboBoxItem Content="EAN-13"/><ComboBoxItem Content="Code 128"/><ComboBoxItem Content="QR Code"/></ComboBox></StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,14,0,0">
                                        <CheckBox x:Name="EnableBatchPrint" Content="Çoklu ürün seçiminde toplu barkod basımına izin ver" IsChecked="True"/>
                                        <CheckBox x:Name="ShowProductNameOnLabel" Content="Etikette ürün adını göster" IsChecked="True"/>
                                        <CheckBox x:Name="ShowPriceOnLabel" Content="Etikette satış fiyatını göster" IsChecked="True"/>
                                        <CheckBox x:Name="ConfirmBeforePrinting" Content="Yazdırmadan önce önizleme ve onay göster" IsChecked="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- System -->
                <TabItem Header="{DynamicResource Settings.Tab.System}">
                    <StackPanel Margin="24">
                        <GroupBox Header="Sunucu &amp; Veritabanı" Style="{StaticResource SectionBox}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="API Sunucu Adresi" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="http://localhost:5188"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Otomatik Yedekleme Saati" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="02:00"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <!-- Salesforce Integration -->
                <TabItem Header="{DynamicResource Settings.Tab.Salesforce}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24">
                            <!-- OAuth Connected App -->
                            <GroupBox Header="{DynamicResource Salesforce.OAuthHeader}" Style="{StaticResource SectionBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Consumer Key (Client ID)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="SfConsumerKey"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Consumer Secret" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="SfConsumerSecret"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Auto Sync -->
                            <GroupBox Header="{DynamicResource Salesforce.AutoSyncHeader}" Style="{StaticResource SectionBox}">
                                <StackPanel>
                                    <CheckBox Content="{DynamicResource Salesforce.SyncAccounts}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Salesforce.SyncProducts}" IsChecked="True"/>
                                    <CheckBox Content="{DynamicResource Salesforce.SyncInvoices}" IsChecked="True"/>
                                    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Salesforce.SyncNow}" Click="SyncAllData_Click" Style="{StaticResource PrimaryCommandButton}" Height="36"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Bottom Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Settings.ResetDefaults}" Style="{StaticResource CommandButton}" Margin="0,0,10,0"
                    Click="ResetButton_Click"/>
            <Button Content="{DynamicResource Settings.SaveChanges}" Style="{StaticResource PrimaryCommandButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
