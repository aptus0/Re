<Window x:Class="Re.Desktop.Views.Settings.ApiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Re.Desktop.ViewModels.Settings"
        Title="Sunucu ve API Ayarları" 
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E7EAEE">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#263244"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9AA6B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="#111827"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#E6EAF0"/>
            <Setter Property="Foreground" Value="#263244"/>
            <Setter Property="BorderBrush" Value="#99A5B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryCommandButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#315D8C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#23486D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:ApiSettingsViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cihaz / Makine IP Bilgileri (Mobil Bağlantı İçin)" FontSize="16" FontWeight="Bold" Foreground="#C62828" />
            <TextBlock Text="Aşağıdaki IP ve Port bilgisini mobil cihazınızda sunucu adresi olarak kullanabilirsiniz." TextWrapping="Wrap" Foreground="#555" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F6F7" BorderBrush="#9AA6B5" BorderThickness="1" Padding="15" CornerRadius="2">
            <StackPanel>
                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cihaz IP Adresi:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding MachineIp, Mode=OneWay}" IsReadOnly="True" Background="#E9EDF2" />
                </Grid>

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Port:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ApiPort, Mode=OneWay}" IsReadOnly="True" Background="#E9EDF2" />
                </Grid>

                <Separator Margin="0,15" />

                <Grid Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Servis Durumu:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ServiceStatus}" FontWeight="Bold" 
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Yerel API Başlat" Command="{Binding StartLocalApiCommand}" Width="120" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryCommandButton}"/>
                    <Button Content="Servisi Kur" Command="{Binding InstallServiceCommand}" Width="92" Margin="0,0,8,0"/>
                    <Button Content="Başlat" Command="{Binding StartServiceCommand}" Width="72" Margin="0,0,8,0"
                            Background="#477A50" BorderBrush="#35613D" Foreground="White"/>
                    <Button Content="Durdur" Command="{Binding StopServiceCommand}" Width="72"
                            Background="#B94A48" BorderBrush="#933A38" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Content="Kapat" Width="100" HorizontalAlignment="Right" Margin="0,15,0,0" Click="CloseButton_Click" />
    </Grid>
</Window>
