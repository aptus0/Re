<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <description>Yeni stok hareketinden sonra ilgili stok kartının bakiyesini giriş/çıkış yönüne göre günceller.</description>
    <environments>Default</environments>
    <formulas>
        <name>SignedQuantity</name><dataType>Number</dataType><scale>4</scale>
        <expression>IF(ISPICKVAL({!$Record.Direction__c}, "Cikis"), -1 * {!$Record.Quantity__c}, {!$Record.Quantity__c})</expression>
    </formulas>
    <formulas>
        <name>NewStockBalance</name><dataType>Number</dataType><scale>4</scale>
        <expression>BLANKVALUE({!Get_Stock_Item.Current_Stock__c}, 0) + {!SignedQuantity}</expression>
    </formulas>
    <interviewLabel>ERP Stok Bakiye Otomasyonu {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ERP Stok Bakiye Otomasyonu</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Stock_Item</name><label>Stok Kartını Getir</label>
        <locationX>176</locationX><locationY>176</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector><targetReference>Update_Stock_Balance</targetReference></connector>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Stock_Item__c</elementReference></value></filters>
        <getFirstRecordOnly>true</getFirstRecordOnly><object>ERP_Stock_Item__c</object><storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Stock_Balance</name><label>Stok Bakiyesini Güncelle</label>
        <locationX>176</locationX><locationY>296</locationY>
        <filterLogic>and</filterLogic>
        <filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Stock_Item__c</elementReference></value></filters>
        <inputAssignments><field>Current_Stock__c</field><value><elementReference>NewStockBalance</elementReference></value></inputAssignments>
        <object>ERP_Stock_Item__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX><locationY>0</locationY>
        <connector><targetReference>Get_Stock_Item</targetReference></connector>
        <object>ERP_Stock_Movement__c</object><recordTriggerType>Create</recordTriggerType><triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
