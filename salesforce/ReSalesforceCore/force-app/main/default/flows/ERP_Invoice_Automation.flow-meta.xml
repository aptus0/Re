<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Calculate_Invoice_Fields</name>
        <label>Fatura Alanlarını Hesapla</label>
        <locationX>176</locationX><locationY>296</locationY>
        <assignmentItems>
            <assignToReference>$Record.Remaining_Amount__c</assignToReference><operator>Assign</operator>
            <value><elementReference>CalculatedRemaining</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Overdue_Days__c</assignToReference><operator>Assign</operator>
            <value><elementReference>CalculatedOverdueDays</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference><operator>Assign</operator>
            <value><elementReference>CalculatedStatus</elementReference></value>
        </assignmentItems>
    </assignments>
    <description>Fatura kaydedilmeden önce kalan bakiye, ödeme durumu ve gecikme gününü otomatik hesaplar.</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculatedRemaining</name><dataType>Currency</dataType><scale>2</scale>
        <expression>MAX(0, BLANKVALUE({!$Record.Total_Amount__c}, 0) - BLANKVALUE({!$Record.Paid_Amount__c}, 0))</expression>
    </formulas>
    <formulas>
        <name>CalculatedOverdueDays</name><dataType>Number</dataType><scale>0</scale>
        <expression>IF(AND(NOT(ISBLANK({!$Record.Due_Date__c})), {!CalculatedRemaining} &gt; 0, {!$Record.Due_Date__c} &lt; TODAY()), TODAY() - {!$Record.Due_Date__c}, 0)</expression>
    </formulas>
    <formulas>
        <name>CalculatedStatus</name><dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Status__c}, "Iptal"), "Iptal", IF(BLANKVALUE({!$Record.Total_Amount__c}, 0) &gt; 0 &amp;&amp; {!CalculatedRemaining} = 0, "Odendi", IF(BLANKVALUE({!$Record.Paid_Amount__c}, 0) &gt; 0, "Kismi_Odendi", TEXT({!$Record.Status__c}))))</expression>
    </formulas>
    <interviewLabel>ERP Fatura Otomasyonu {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ERP Fatura Otomasyonu</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX><locationY>0</locationY>
        <connector><targetReference>Calculate_Invoice_Fields</targetReference></connector>
        <object>ERP_Invoice__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
